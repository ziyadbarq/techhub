  "Form with React Hook Form": {
    "prefix": "rhform",
    "body": [
      "\"use client\";",
      "",
      "import { useForm } from 'react-hook-form';",
      "import { zodResolver } from '@hookform/resolvers/zod';",
      "import { toast } from 'sonner';",
      "import { ${1:Schema}Schema, type ${1}DTO } from '@/interface-adapters/dtos/${2:module}/${1/(.*)/${1:/downcase}/}.dto';",
      "",
      "export function ${3:FormName}() {",
      "  const form = useForm<${1}DTO>({",
      "    resolver: zodResolver(${1}Schema),",
      "    defaultValues: {",
      "      $4",
      "    },",
      "  });",
      "",
      "  async function onSubmit(data: ${1}DTO) {",
      "    try {",
      "      $0",
      "      toast.success('Success!');",
      "    } catch (error) {",
      "      toast.error('An error occurred');",
      "    }",
      "  }",
      "",
      "  return (",
      "    <form onSubmit={form.handleSubmit(onSubmit)}>",
      "      {/* Form fields */}",
      "    </form>",
      "  );",
      "}"
    ],
    "description": "Create a form with React Hook Form and Zod"
