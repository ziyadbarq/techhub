// Prisma Schema for Barq Assets
// Database: PostgreSQL

generator client {
  provider     = "prisma-client"
  output       = "../../../generated/prisma"
  engineType   = "client" // Prisma 7: Rust-free engine for 90% smaller bundle, 3x faster queries
  postgenerate = "node scripts/recreate-prisma-index.js" // Auto-regenerate barrel export index.ts
}

datasource db {
  provider = "postgresql"
}

// ============================================
// AUTHENTICATION (Better Auth)
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Authentication tracking
  lastLoginMethod String? // 'email' | 'microsoft' | other OAuth providers
  lastLoginAt     DateTime?

  // Relations
  accounts        Account[]
  sessions        Session[]
  roles           UserRole[]
  person          Person? // Optional link to organizational person
  auditLogsAsUser AuditLogEntry[] @relation("AuditLogChangedByUser")

  @@index([email])
  @@map("users")
}

model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String    @default("oauth")
  provider          String
  providerAccountId String
  refreshToken      String?   @db.Text
  accessToken       String?   @db.Text
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?   @db.Text
  sessionState      String?
  password          String?   @db.Text // Better Auth email/password storage
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([expiresAt]) // Medium-priority: Cleanup expired sessions
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier])
  @@index([expiresAt]) // Medium-priority: Cleanup expired tokens
  @@map("verification")
}

// ============================================
// RBAC (Role-Based Access Control)
// ============================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  // Role Hierarchy - Self-referential relationship
  parentId String? @db.Text
  parent   Role?   @relation("RoleHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Role[]  @relation("RoleHierarchy")

  // Relations
  permissions           RolePermission[]
  users                 UserRole[]
  personsPrimaryRole    Person[]               @relation("PersonPrimaryRole")
  personRoleAssignments PersonRoleAssignment[] @relation("PersonRoleAssignments")
  lifecycleTransitions  LifecycleTransition[]  @relation("TransitionRequiredRole")

  @@index([name])
  @@index([isActive])
  @@index([parentId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  resource    String
  action      String
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  roles RolePermission[]

  @@index([resource, action])
  @@index([isActive])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now())

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  createdBy String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([expiresAt]) // High-priority: Expired role cleanup
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  changes    Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

// CodeSequence model
// Auto-generation of unique codes for entities
model CodeSequence {
  id         String   @id @default(cuid())
  entityType String   @unique // e.g., "VENDOR", "ASSET_KIT", "LIFECYCLE_STATE_{modelId}"
  prefix     String // e.g., "VENDOR", "KIT", "STATE"
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType])
  @@map("code_sequences")
}

// ============================================
// FOUNDATION LAYER: Organization, People, Locations, Vendors, Lifecycle
// ============================================

// OrganizationUnit model
// Hierarchy: Company > Business Unit > Department > Team
model OrganizationUnit {
  id          String               @id @default(cuid())
  parentId    String?
  name        String
  code        String               @unique
  description String?              @db.Text
  unitType    OrganizationUnitType @default(OTHER)
  managerId   String?
  costCenter  String?
  level       Int // 1=Company, 2=BU, 3=Dept, 4=Team
  isActive    Boolean              @default(true)
  note        String?              @db.Text
  metadata    Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Relations
  parent             OrganizationUnit?   @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           OrganizationUnit[]  @relation("OrgUnitHierarchy")
  manager            Person?             @relation("OrgUnitManager", fields: [managerId], references: [id], onDelete: SetNull)
  people             Person[]            @relation("PersonOrgUnit")
  configurationItems ConfigurationItem[]
  dataOwnerships     DataOwnership[]     @relation("DataOwnershipOrgUnit")
  reservations       AssetReservation[]  @relation("ReservationForOrgUnit")

  // Indexes
  @@index([parentId])
  @@index([code])
  @@index([managerId])
  @@index([isActive])
  @@index([level])
  @@index([unitType])
  @@map("organization_units")
}

// Person model
// Organizational people (different from Better Auth User)
model Person {
  id              String    @id @default(cuid())
  azureAdId       String?   @unique // Immutable MS Graph ID - source of truth for user sync
  userId          String?   @unique // Optional link to Better Auth User
  firstName       String
  lastName        String
  middleName      String?
  email           String    @unique
  phone           String?
  mobile          String?
  employeeId      String?   @unique
  orgUnitId       String
  primaryRoleId   String
  managerId       String?
  title           String?
  office          String?            // Office location from MS Graph (e.g., "Riyadh HQ", "India Office")
  locationId      String?
  department      String?
  hireDate        DateTime?
  terminationDate DateTime?
  isActive        Boolean   @default(true)
  isExcluded      Boolean   @default(false) // TechHub-specific: hide from app (service accounts)
  metadata        Json?
  deletedAt       DateTime? // Soft delete timestamp
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user                         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgUnit                      OrganizationUnit       @relation("PersonOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  primaryRole                  Role                   @relation("PersonPrimaryRole", fields: [primaryRoleId], references: [id], onDelete: Restrict)
  manager                      Person?                @relation("PersonManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports                Person[]               @relation("PersonManager")
  location                     Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  managedOrgUnits              OrganizationUnit[]     @relation("OrgUnitManager")
  roleAssignments              PersonRoleAssignment[]
  configurationItems           ConfigurationItem[]
  stockMovements               StockMovement[]
  verificationCampaigns        VerificationCampaign[]
  verificationItems            VerificationItem[]
  auditLogsChanged             AuditLogEntry[]        @relation("AuditLogChangedBy")
  attachments                  Attachment[]
  dataOwnerships                DataOwnership[]        @relation("DataOwnershipPerson")
  assignedMaintenanceSchedules  MaintenanceSchedule[]
  performedMaintenanceRecords   MaintenanceRecord[]
  initiatedDisposals            AssetDisposal[]        @relation("DisposalInitiatedBy")
  approvedDisposals             AssetDisposal[]        @relation("DisposalApprovedBy")
  disposalApprovals             DisposalApproval[]     @relation("DisposalApprover")
  uploadedDisposalDocuments     DisposalDocument[]     @relation("DisposalDocumentUploader")
  kitCheckouts                  AssetKitCheckout[]     @relation("KitCheckoutBy")
  reservationsFor               AssetReservation[]     @relation("ReservationForPerson")
  reservationsCreated           AssetReservation[]     @relation("ReservationBy")
  reservationsConfirmed         AssetReservation[]     @relation("ReservationConfirmedBy")
  reservationsCancelled         AssetReservation[]     @relation("ReservationCancelledBy")
  serviceOwnerships             ServiceOwnership[]
  intuneDevices                 IntuneDevice[]         @relation("IntuneDevicePerson")

  // Indexes
  @@index([azureAdId])
  @@index([userId])
  @@index([email])
  @@index([employeeId])
  @@index([orgUnitId])
  @@index([primaryRoleId])
  @@index([managerId])
  @@index([locationId])
  @@index([isActive])
  @@index([isExcluded])
  @@map("persons")
}

// PersonRoleAssignment model
// Many-to-many Person-Role with temporal data
model PersonRoleAssignment {
  id        String    @id @default(cuid())
  personId  String
  roleId    String
  scope     String?
  startDate DateTime  @default(now())
  endDate   DateTime?
  isPrimary Boolean   @default(false)
  isActive  Boolean   @default(true)
  note      String?   @db.Text
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  person Person @relation(fields: [personId], references: [id], onDelete: Restrict)
  role   Role   @relation("PersonRoleAssignments", fields: [roleId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([personId])
  @@index([roleId])
  @@index([isPrimary])
  @@index([startDate, endDate])
  @@map("person_role_assignments")
}

// Location model
// Hierarchy: Country > City > Campus > Building > Floor > Room > Rack
model Location {
  id           String       @id @default(cuid())
  parentId     String?
  name         String
  code         String       @unique
  description  String?      @db.Text
  locationType LocationType
  address      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  timeZone     String?
  isActive     Boolean      @default(true)
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  parent             Location?           @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Location[]          @relation("LocationHierarchy")
  persons            Person[]
  stockLocations     StockLocation[]
  configurationItems ConfigurationItem[]

  // Indexes
  @@index([parentId])
  @@index([code])
  @@index([locationType])
  @@index([city])
  @@index([country])
  @@index([isActive])
  @@map("locations")
}

// Vendor model
model Vendor {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  legalName    String?
  description  String?    @db.Text
  vendorType   VendorType @default(OTHER)
  taxId        String?
  website      String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  paymentTerms String?    @db.Text
  isPreferred  Boolean    @default(false)
  isActive     Boolean    @default(true)
  tags         String[]
  note         String?    @db.Text
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  contacts        VendorContact[]
  assetModels     AssetModel[]
  assets          Asset[]
  warranties      Warranty[]
  contracts       Contract[]
  licenseProducts LicenseProduct[]
  disposals       AssetDisposal[]
  services        Service[]

  // Indexes
  @@index([name])
  @@index([code])
  @@index([email])
  @@index([vendorType])
  @@index([isActive])
  @@index([isPreferred])
  @@map("vendors")
}

// VendorContact model
model VendorContact {
  id        String   @id @default(cuid())
  vendorId  String
  firstName String
  lastName  String
  title     String?
  email     String?
  phone     String?
  mobile    String?
  role      String? // Account manager, Support, Sales, etc.
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  note      String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([vendorId])
  @@index([email])
  @@index([isPrimary])
  @@map("vendor_contacts")
}

// ExchangeRate model
// Multi-currency support - stores exchange rates to SAR (Saudi Riyal)
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique // 3-letter ISO code (USD, EUR, GBP, SAR)
  rateToSAR Decimal  @db.Decimal(10, 6) // 1 CURRENCY = X SAR
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([currency])
  @@index([isActive])
  @@map("exchange_rates")
}

// LifecycleModel model
// Reusable state machine definitions (for CIs, Assets, Licenses)
model LifecycleModel {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  states          LifecycleState[]
  transitions     LifecycleTransition[]
  ciClasses       CIClass[]
  assetCategories AssetCategory[]
  licenseProducts LicenseProduct[]

  // Indexes
  @@index([name])
  @@map("lifecycle_models")
}

// LifecycleState model
model LifecycleState {
  id               String    @id @default(cuid())
  lifecycleModelId String
  name             String
  code             String
  description      String?   @db.Text
  stateType        StateType @default(ACTIVE)
  isActiveState    Boolean   @default(false) // true if considered in-use/active
  isTerminalState  Boolean   @default(false) // true if end-of-life
  sortOrder        Int
  isActive         Boolean   @default(true)
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  lifecycleModel     LifecycleModel        @relation(fields: [lifecycleModelId], references: [id], onDelete: Restrict)
  transitionsFrom    LifecycleTransition[] @relation("TransitionFrom")
  transitionsTo      LifecycleTransition[] @relation("TransitionTo")
  configurationItems ConfigurationItem[]
  assets             Asset[]

  // Indexes
  @@unique([lifecycleModelId, code])
  @@index([lifecycleModelId])
  @@index([code])
  @@index([sortOrder])
  @@index([stateType])
  @@map("lifecycle_states")
}

// LifecycleTransition model
model LifecycleTransition {
  id               String   @id @default(cuid())
  lifecycleModelId String
  name             String
  description      String?  @db.Text
  fromStateId      String
  toStateId        String
  requiredRoleId   String? // Optional: role required to execute transition
  requiresApproval Boolean  @default(false)
  approvalPolicy   Json? // JSON rule definition
  conditions       Json?
  isAutomated      Boolean  @default(false)
  isActive         Boolean  @default(true)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  lifecycleModel LifecycleModel @relation(fields: [lifecycleModelId], references: [id], onDelete: Restrict)
  fromState      LifecycleState @relation("TransitionFrom", fields: [fromStateId], references: [id], onDelete: Restrict)
  toState        LifecycleState @relation("TransitionTo", fields: [toStateId], references: [id], onDelete: Restrict)
  requiredRole   Role?          @relation("TransitionRequiredRole", fields: [requiredRoleId], references: [id], onDelete: SetNull)

  // Indexes
  @@unique([lifecycleModelId, fromStateId, toStateId])
  @@index([lifecycleModelId])
  @@index([fromStateId])
  @@index([toStateId])
  @@index([requiredRoleId])
  @@map("lifecycle_transitions")
}

// FieldDefinition model
// Meta-model for dynamic attributes
model FieldDefinition {
  id              String            @id @default(cuid())
  name            String            @unique // internal name, e.g. cpu_cores
  label           String // display label
  dataType        FieldDataTypeEnum
  description     String?           @db.Text
  entityType      String
  isGlobal        Boolean           @default(false) // true if reusable across many domains
  isRequired      Boolean           @default(false)
  isUnique        Boolean           @default(false)
  validationRules Json? // min/max, regex, etc.
  defaultValue    Json?
  enumOptions     Json? // for ENUM data_type
  uiGroup         String? // group/tab in UI
  uiOrder         Int               @default(0)
  displayOrder    Int               @default(0)
  isSearchable    Boolean           @default(false)
  isFilterable    Boolean           @default(false)
  isActive        Boolean           @default(true)
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  ciClassFields        CIClassField[]
  assetCategoryFields  AssetCategoryField[]
  licenseProductFields LicenseProductField[]

  // Indexes
  @@index([name])
  @@index([dataType])
  @@index([entityType])
  @@index([isGlobal])
  @@index([isActive])
  @@map("field_definitions")
}

// ============================================
// CMDB: CI CLASSES, CONFIGURATION ITEMS, RELATIONSHIPS
// ============================================

// CIClass model
model CIClass {
  id                 String           @id @default(cuid())
  name               String           @unique
  code               String           @unique
  parentClassId      String?
  description        String?          @db.Text
  lifecycleModelId   String?
  defaultCriticality CriticalityEnum?
  defaultEnvironment EnvironmentEnum?
  isDiscoverable     Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relations
  parentClass                CIClass?                @relation("CIClassHierarchy", fields: [parentClassId], references: [id], onDelete: Restrict)
  childClasses               CIClass[]               @relation("CIClassHierarchy")
  lifecycleModel             LifecycleModel?         @relation(fields: [lifecycleModelId], references: [id], onDelete: SetNull)
  fields                     CIClassField[]
  configurationItems         ConfigurationItem[]
  relationshipTypeScopesFrom RelationshipTypeScope[] @relation("RelationshipTypeScopeFrom")
  relationshipTypeScopesTo   RelationshipTypeScope[] @relation("RelationshipTypeScopeTo")
  dataOwnerships             DataOwnership[]

  // Indexes
  @@index([parentClassId])
  @@index([code])
  @@index([lifecycleModelId])
  @@map("ci_classes")
}

// CIClassField model
model CIClassField {
  id                String   @id @default(cuid())
  ciClassId         String
  fieldDefinitionId String
  isRequired        Boolean  @default(false)
  isUnique          Boolean  @default(false)
  isVisible         Boolean  @default(true)
  defaultValue      Json?
  uiOrder           Int      @default(0)
  note              String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  ciClass         CIClass         @relation(fields: [ciClassId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([ciClassId, fieldDefinitionId])
  @@index([ciClassId])
  @@index([fieldDefinitionId])
  @@map("ci_class_fields")
}

// ConfigurationItem model
model ConfigurationItem {
  id                    String           @id @default(cuid())
  name                  String
  ciClassId             String
  lifecycleStateId      String?
  criticality           CriticalityEnum?
  environment           EnvironmentEnum?
  primaryOwnerPersonId  String?
  primaryOwnerOrgUnitId String?
  locationId            String?
  linkedAssetId         String?
  ciKey                 String?          @unique // unique business key, e.g. hostname
  description           String?          @db.Text
  attributes            Json? // dynamic fields per CIClassField
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  ciClass             CIClass           @relation(fields: [ciClassId], references: [id], onDelete: Restrict)
  lifecycleState      LifecycleState?   @relation(fields: [lifecycleStateId], references: [id], onDelete: SetNull)
  primaryOwnerPerson  Person?           @relation(fields: [primaryOwnerPersonId], references: [id], onDelete: SetNull)
  primaryOwnerOrgUnit OrganizationUnit? @relation(fields: [primaryOwnerOrgUnitId], references: [id], onDelete: SetNull)
  location            Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  linkedAsset         Asset?            @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)
  relationshipsFrom   CIRelationship[]  @relation("CIRelationshipFrom")
  relationshipsTo     CIRelationship[]  @relation("CIRelationshipTo")

  // Indexes
  @@index([ciClassId])
  @@index([lifecycleStateId])
  @@index([primaryOwnerPersonId])
  @@index([primaryOwnerOrgUnitId])
  @@index([locationId])
  @@index([ciKey])
  @@index([name])
  @@map("configuration_items")
}

// RelationshipType model
model RelationshipType {
  id          String                    @id @default(cuid())
  name        String                    @unique
  code        String                    @unique
  description String?                   @db.Text
  direction   RelationshipDirectionEnum
  isImpacting Boolean                   @default(false) // if failure of "to" impacts "from"
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  // Relations
  scopes        RelationshipTypeScope[]
  relationships CIRelationship[]

  // Indexes
  @@index([code])
  @@map("relationship_types")
}

// RelationshipTypeScope model
model RelationshipTypeScope {
  id                 String   @id @default(cuid())
  relationshipTypeId String
  fromCiClassId      String
  toCiClassId        String
  note               String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  relationshipType RelationshipType @relation(fields: [relationshipTypeId], references: [id], onDelete: Cascade)
  fromCiClass      CIClass          @relation("RelationshipTypeScopeFrom", fields: [fromCiClassId], references: [id], onDelete: Cascade)
  toCiClass        CIClass          @relation("RelationshipTypeScopeTo", fields: [toCiClassId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([relationshipTypeId, fromCiClassId, toCiClassId])
  @@index([relationshipTypeId])
  @@index([fromCiClassId])
  @@index([toCiClassId])
  @@map("relationship_type_scopes")
}

// CIRelationship model
model CIRelationship {
  id                 String    @id @default(cuid())
  fromCiId           String
  toCiId             String
  relationshipTypeId String
  isActive           Boolean   @default(true)
  validFrom          DateTime  @default(now())
  validTo            DateTime?
  note               String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  fromCi           ConfigurationItem @relation("CIRelationshipFrom", fields: [fromCiId], references: [id], onDelete: Restrict)
  toCi             ConfigurationItem @relation("CIRelationshipTo", fields: [toCiId], references: [id], onDelete: Restrict)
  relationshipType RelationshipType  @relation(fields: [relationshipTypeId], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([fromCiId, toCiId, relationshipTypeId])
  @@index([fromCiId])
  @@index([toCiId])
  @@index([relationshipTypeId])
  @@index([isActive])
  @@index([isActive, relationshipTypeId]) // High-priority: Topology queries
  @@index([validFrom, validTo]) // High-priority: Temporal queries
  @@map("ci_relationships")
}

// ============================================
// IT ASSET MANAGEMENT (ITAM): ASSETS, MODELS, STOCK
// ============================================

// AssetCategory model
model AssetCategory {
  id               String   @id @default(cuid())
  name             String   @unique
  code             String   @unique
  description      String?  @db.Text
  lifecycleModelId String?
  isConsumable     Boolean  @default(false) // true for items like cables, mice
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  lifecycleModel LifecycleModel?      @relation(fields: [lifecycleModelId], references: [id], onDelete: SetNull)
  fields         AssetCategoryField[]
  assetModels    AssetModel[]
  assets         Asset[]
  dataOwnerships DataOwnership[]
  kitItems       AssetKitItem[]

  // Indexes
  @@index([code])
  @@index([lifecycleModelId])
  @@map("asset_categories")
}

// AssetCategoryField model
model AssetCategoryField {
  id                String   @id @default(cuid())
  assetCategoryId   String
  fieldDefinitionId String
  isRequired        Boolean  @default(false)
  isUnique          Boolean  @default(false)
  isVisible         Boolean  @default(true)
  uiOrder           Int      @default(0)
  defaultValue      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  assetCategory   AssetCategory   @relation(fields: [assetCategoryId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([assetCategoryId, fieldDefinitionId])
  @@index([assetCategoryId])
  @@index([fieldDefinitionId])
  @@map("asset_category_fields")
}

// AssetModel model
model AssetModel {
  id                    String   @id @default(cuid())
  assetCategoryId       String
  vendorId              String
  name                  String
  code                  String   @unique
  description           String?  @db.Text
  defaultWarrantyMonths Int?
  defaultAttributes     Json? // default specs: RAM, CPU, screen size, etc.
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  assetCategory AssetCategory @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assets        Asset[]
  kitItems      AssetKitItem[]

  // Indexes
  @@index([code])
  @@index([assetCategoryId])
  @@index([vendorId])
  @@map("asset_models")
}

// StockLocation model
model StockLocation {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  locationId  String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  location           Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assets             Asset[]
  stockMovementsFrom StockMovement[] @relation("StockMovementFrom")
  stockMovementsTo   StockMovement[] @relation("StockMovementTo")

  // Indexes
  @@index([code])
  @@index([locationId])
  @@map("stock_locations")
}

// StockMovement model
model StockMovement {
  id                  String                @id @default(cuid())
  movementType        StockMovementTypeEnum
  stockLocationFromId String?
  stockLocationToId   String?
  assetId             String?
  quantity            Int                   @default(1)
  reason              String?               @db.Text
  performedById       String
  occurredAt          DateTime              @default(now())
  createdAt           DateTime              @default(now())

  // Relations
  stockLocationFrom StockLocation? @relation("StockMovementFrom", fields: [stockLocationFromId], references: [id], onDelete: SetNull)
  stockLocationTo   StockLocation? @relation("StockMovementTo", fields: [stockLocationToId], references: [id], onDelete: SetNull)
  asset             Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  performedBy       Person         @relation(fields: [performedById], references: [id], onDelete: Restrict)

  // Indexes
  @@index([movementType])
  @@index([stockLocationFromId])
  @@index([stockLocationToId])
  @@index([assetId])
  @@index([performedById])
  @@index([occurredAt])
  @@map("stock_movements")
}

// Asset model
model Asset {
  id                     String    @id @default(cuid())
  assetTag               String    @unique
  assetCategoryId        String
  assetModelId           String?
  vendorId               String?
  contractId             String?
  lifecycleStateId       String?
  serialNumber           String?   @unique
  purchaseDate           DateTime?
  purchaseCost           Decimal?  @db.Decimal(12, 2)
  purchaseCostSar        Decimal?  @db.Decimal(12, 2) // Frozen SAR snapshot at create/update
  currency               String?
  depreciationModel      String?
  depreciationStart      DateTime?
  depreciationEnd        DateTime?
  warrantyEndDate        DateTime?
  condition              String? // Asset condition: NEW, GOOD, FAIR, POOR
  currentStockLocationId String?
  attributes             Json? // dynamic fields per AssetCategoryField
  note                   String?   @db.Text
  deletedAt              DateTime? // Soft delete timestamp
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Relations
  assetCategory        AssetCategory         @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)
  assetModel           AssetModel?           @relation(fields: [assetModelId], references: [id], onDelete: SetNull)
  vendor               Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  contract             Contract?             @relation(fields: [contractId], references: [id], onDelete: SetNull)
  lifecycleState       LifecycleState?       @relation(fields: [lifecycleStateId], references: [id], onDelete: SetNull)
  currentStockLocation StockLocation?        @relation(fields: [currentStockLocationId], references: [id], onDelete: SetNull)
  warranties           Warranty[]
  configurationItems   ConfigurationItem[]
  stockMovements       StockMovement[]
  assetAssignments     AssetAssignment[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords   MaintenanceRecord[]
  disposals            AssetDisposal[]        @relation("AssetDisposals")
  reservations         AssetReservation[]
  kitCheckoutItems     AssetKitCheckoutItem[]
  serviceAssets        ServiceAsset[]
  intuneDevice         IntuneDevice?          @relation("IntuneDeviceAsset")

  // Indexes
  @@index([assetTag])
  @@index([assetCategoryId])
  @@index([assetModelId])
  @@index([vendorId])
  @@index([contractId])
  @@index([lifecycleStateId])
  @@index([serialNumber])
  @@index([currentStockLocationId])
  @@index([condition]) // High-priority: Filter by condition
  @@index([warrantyEndDate]) // High-priority: Expiring warranties
  @@index([assetCategoryId, lifecycleStateId]) // High-priority: Dashboard queries
  @@index([condition, lifecycleStateId]) // High-priority: Filter by condition + state
  @@index([purchaseDate]) // Medium-priority: Age-based queries
  @@index([depreciationStart, depreciationEnd]) // Medium-priority: Depreciation queries
  @@map("assets")
}

// AssetAssignment model
model AssetAssignment {
  id                    String           @id @default(cuid())
  assetId               String
  assigneeType          AssigneeTypeEnum
  assigneeId            String // points to Person/OrgUnit/Location/CI depending on type
  startDate             DateTime         @default(now())
  endDate               DateTime?
  isPrimary             Boolean          @default(false)
  conditionOnAssignment String? // Condition when asset was assigned
  conditionOnReturn     String? // Condition when asset was returned
  note                  String?          @db.Text
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // Indexes
  @@index([assetId])
  @@index([assigneeType, assigneeId])
  @@index([startDate, endDate])
  @@map("asset_assignments")
}

// Warranty model
// Comprehensive warranty tracking with support for multiple warranties per asset
model Warranty {
  id              String               @id @default(cuid())
  assetId         String
  vendorId        String? // Nullable to support third-party warranty providers
  coverageType    WarrantyCoverageType @default(STANDARD)
  coverageDetails String?              @db.Text
  policyReference String?
  slaDetails      Json? // SLA terms, response times, coverage hours
  startDate       DateTime
  endDate         DateTime
  cost            Decimal?             @db.Decimal(12, 2)
  currency        String?
  note            String?              @db.Text
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Relations
  asset  Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  // Indexes
  @@index([assetId])
  @@index([vendorId])
  @@index([startDate, endDate])
  @@index([endDate]) // For expiration queries
  @@index([coverageType])
  @@map("warranties")
}

// ============================================
// MAINTENANCE SYSTEM
// ============================================

// MaintenanceSchedule model
// Defines recurring preventive maintenance schedules for assets
model MaintenanceSchedule {
  id                       String   @id @default(cuid())
  assetId                  String
  title                    String
  description              String?  @db.Text
  scheduleType             String // ScheduleType enum: WEEKLY, MONTHLY, QUARTERLY, YEARLY, CUSTOM
  intervalValue            Int      @default(1)
  startDate                DateTime @default(now())
  nextDueDate              DateTime
  isActive                 Boolean  @default(true)
  assignedToId             String?
  estimatedDurationMinutes Int?
  priority                 String   @default("MEDIUM") // MaintenancePriority enum: LOW, MEDIUM, HIGH, CRITICAL
  instructions             String?  @db.Text
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  asset              Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignedTo         Person?             @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  maintenanceRecords MaintenanceRecord[]

  // Indexes
  @@index([assetId])
  @@index([assignedToId])
  @@index([nextDueDate])
  @@index([isActive])
  @@index([scheduleType])
  @@index([priority])
  @@index([startDate]) // Medium-priority: Schedule activation
  @@map("maintenance_schedules")
}

// MaintenanceRecord model
// Tracks actual maintenance work performed or scheduled on assets
model MaintenanceRecord {
  id                    String    @id @default(cuid())
  assetId               String
  maintenanceScheduleId String?
  title                 String
  description           String?   @db.Text
  scheduledDate         DateTime
  completedDate         DateTime?
  performedById         String?
  status                String    @default("SCHEDULED") // MaintenanceStatus enum: SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, OVERDUE
  notes                 String?   @db.Text
  cost                  Decimal?  @db.Decimal(12, 2)
  currency              String? // Currency code (USD, EUR, GBP, SAR, etc.)
  partsUsed             Json? // Array of strings
  nextMaintenanceDate   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  asset               Asset                @relation(fields: [assetId], references: [id], onDelete: Restrict)
  maintenanceSchedule MaintenanceSchedule? @relation(fields: [maintenanceScheduleId], references: [id], onDelete: SetNull)
  performedBy         Person?              @relation(fields: [performedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([assetId])
  @@index([maintenanceScheduleId])
  @@index([performedById])
  @@index([scheduledDate])
  @@index([completedDate])
  @@index([status])
  @@index([status, assetId]) // High-priority: Asset maintenance history
  @@map("maintenance_records")
}

// ============================================
// ASSET DISPOSAL WORKFLOW
// ============================================

// AssetDisposal model
// Tracks asset disposal with approval workflow, sanitization, and certificates
model AssetDisposal {
  id                    String    @id @default(cuid())
  assetId               String    @map("asset_id")
  disposalType          String    @map("disposal_type") // DONATION, SALE, RECYCLING, DESTRUCTION, OTHER
  reason                String?
  initiatedById         String    @map("initiated_by_id")
  approvedById          String?   @map("approved_by_id")
  approvedAt            DateTime? @map("approved_at")
  status                String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, IN_PROGRESS, COMPLETED, CANCELLED
  estimatedValue        Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  actualProceeds        Decimal?  @map("actual_proceeds") @db.Decimal(12, 2)
  currency              String?
  sanitizationChecklist Json?     @map("sanitization_checklist")
  disposalDate          DateTime? @map("disposal_date")
  certificateNumber     String?   @unique @map("certificate_number")
  certificateIssuedAt   DateTime? @map("certificate_issued_at")
  disposalVendorId      String?   @map("disposal_vendor_id")
  recipientInfo         String?   @map("recipient_info") @db.Text
  note                  String?   @db.Text
  metadata              Json?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Relations
  asset          Asset              @relation("AssetDisposals", fields: [assetId], references: [id], onDelete: Restrict)
  initiatedBy    Person             @relation("DisposalInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)
  approvedBy     Person?            @relation("DisposalApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  disposalVendor Vendor?            @relation(fields: [disposalVendorId], references: [id], onDelete: SetNull)
  approvals      DisposalApproval[]
  documents      DisposalDocument[]

  // Indexes
  @@index([assetId])
  @@index([status])
  @@index([disposalType])
  @@index([initiatedById])
  @@index([approvedById])
  @@index([disposalDate])
  @@index([certificateNumber])
  @@index([status, disposalType]) // High-priority: Dashboard queries
  @@index([approvedAt]) // Medium-priority: Approval timeline
  @@index([certificateIssuedAt]) // Medium-priority: Certificate tracking
  @@map("asset_disposals")
}

// DisposalApproval model
// Multi-level approval tracking for disposal requests
model DisposalApproval {
  id         String    @id @default(cuid())
  disposalId String    @map("disposal_id")
  approverId String    @map("approver_id")
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decisionAt DateTime? @map("decision_at")
  comment    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  disposal AssetDisposal @relation(fields: [disposalId], references: [id], onDelete: Cascade)
  approver Person        @relation("DisposalApprover", fields: [approverId], references: [id], onDelete: Restrict)

  // Indexes
  @@index([disposalId])
  @@index([approverId])
  @@index([status])
  @@index([decisionAt]) // Medium-priority: Decision timeline
  @@map("disposal_approvals")
}

// DisposalDocument model
// Tracks documents attached to disposals (certificates, receipts, photos)
model DisposalDocument {
  id           String   @id @default(cuid())
  disposalId   String   @map("disposal_id")
  documentType String   @map("document_type") // CERTIFICATE, RECEIPT, INVOICE, PHOTO, OTHER
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  mimeType     String?  @map("mime_type")
  sizeBytes    BigInt?  @map("size_bytes")
  uploadedById String   @map("uploaded_by_id")
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  // Relations
  disposal   AssetDisposal @relation(fields: [disposalId], references: [id], onDelete: Cascade)
  uploadedBy Person        @relation("DisposalDocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  // Indexes
  @@index([disposalId])
  @@index([documentType])
  @@index([uploadedById])
  @@map("disposal_documents")
}

// ============================================
// ASSET KITS & BUNDLES
// ============================================

// AssetKit model
// Reusable kit templates (e.g., "New Hire Kit", "Executive Package")
model AssetKit {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?  @db.Text
  kitType     String   @map("kit_type") // NEW_HIRE, CONTRACTOR, EXECUTIVE, PROJECT, TEMPORARY, OTHER
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  items     AssetKitItem[]
  checkouts AssetKitCheckout[]

  // Indexes
  @@index([code])
  @@index([kitType])
  @@index([isActive])
  @@map("asset_kits")
}

// AssetKitItem model
// Items included in a kit template (category or specific model)
model AssetKitItem {
  id              String   @id @default(cuid())
  assetKitId      String   @map("asset_kit_id")
  assetCategoryId String?  @map("asset_category_id")
  assetModelId    String?  @map("asset_model_id")
  quantity        Int      @default(1)
  isRequired      Boolean  @default(true) @map("is_required")
  note            String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  assetKit      AssetKit               @relation(fields: [assetKitId], references: [id], onDelete: Cascade)
  assetCategory AssetCategory?         @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)
  assetModel    AssetModel?            @relation(fields: [assetModelId], references: [id], onDelete: SetNull)
  checkoutItems AssetKitCheckoutItem[]

  // Indexes
  @@index([assetKitId])
  @@index([assetCategoryId])
  @@index([assetModelId])
  @@map("asset_kit_items")
}

// AssetKitCheckout model
// Actual kit checkout instance tracking
model AssetKitCheckout {
  id                 String    @id @default(cuid())
  assetKitId         String    @map("asset_kit_id")
  assigneeType       String    @map("assignee_type") // PERSON, ORG_UNIT, LOCATION
  assigneeId         String    @map("assignee_id")
  checkoutDate       DateTime  @default(now()) @map("checkout_date")
  expectedReturnDate DateTime? @map("expected_return_date")
  actualReturnDate   DateTime? @map("actual_return_date")
  status             String    @default("CHECKED_OUT") @map("status") // CHECKED_OUT, PARTIALLY_RETURNED, RETURNED, CANCELLED
  checkedOutById     String    @map("checked_out_by_id")
  note               String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  assetKit     AssetKit               @relation(fields: [assetKitId], references: [id], onDelete: Restrict)
  checkedOutBy Person                 @relation("KitCheckoutBy", fields: [checkedOutById], references: [id], onDelete: Restrict)
  items        AssetKitCheckoutItem[]

  // Indexes
  @@index([assetKitId])
  @@index([assigneeType, assigneeId])
  @@index([status])
  @@index([checkedOutById])
  @@index([expectedReturnDate])
  @@index([checkoutDate]) // Medium-priority: Checkout history
  @@index([actualReturnDate]) // Medium-priority: Return tracking
  @@map("asset_kit_checkouts")
}

// AssetKitCheckoutItem model
// Individual assets tracked within a kit checkout
model AssetKitCheckoutItem {
  id                  String    @id @default(cuid())
  kitCheckoutId       String    @map("kit_checkout_id")
  assetId             String    @map("asset_id")
  kitItemId           String    @map("kit_item_id")
  checkoutDate        DateTime  @default(now()) @map("checkout_date")
  returnDate          DateTime? @map("return_date")
  status              String    @default("CHECKED_OUT") @map("status") // CHECKED_OUT, RETURNED, DAMAGED, LOST
  conditionAtCheckout String?   @map("condition_at_checkout") @db.Text
  conditionAtReturn   String?   @map("condition_at_return") @db.Text
  note                String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  kitCheckout AssetKitCheckout @relation(fields: [kitCheckoutId], references: [id], onDelete: Cascade)
  asset       Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  kitItem     AssetKitItem     @relation(fields: [kitItemId], references: [id], onDelete: Restrict)

  // Indexes
  @@index([kitCheckoutId])
  @@index([assetId])
  @@index([kitItemId])
  @@index([status])
  @@map("asset_kit_checkout_items")
}

// ============================================
// ASSET RESERVATIONS
// ============================================

// AssetReservation model
// Reserve assets for future use with conflict detection
model AssetReservation {
  id                   String    @id @default(uuid())
  assetId              String    @map("asset_id")
  reservedForPersonId  String?   @map("reserved_for_person_id")
  reservedForOrgUnitId String?   @map("reserved_for_org_unit_id")
  reservedById         String    @map("reserved_by_id")
  startDate            DateTime  @map("start_date")
  endDate              DateTime  @map("end_date")
  status               String    @default("PENDING") @map("status") // PENDING, CONFIRMED, ACTIVE, COMPLETED, CANCELLED
  purpose              String?   @db.Text
  note                 String?   @db.Text
  confirmationDate     DateTime? @map("confirmation_date")
  confirmedById        String?   @map("confirmed_by_id")
  cancellationReason   String?   @map("cancellation_reason") @db.Text
  cancelledAt          DateTime? @map("cancelled_at")
  cancelledById        String?   @map("cancelled_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  // Relations
  asset                   Asset                      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  reservedForPerson       Person?                    @relation("ReservationForPerson", fields: [reservedForPersonId], references: [id], onDelete: SetNull)
  reservedForOrgUnit      OrganizationUnit?          @relation("ReservationForOrgUnit", fields: [reservedForOrgUnitId], references: [id], onDelete: SetNull)
  reservedBy              Person                     @relation("ReservationBy", fields: [reservedById], references: [id], onDelete: Restrict)
  confirmedBy             Person?                    @relation("ReservationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  cancelledBy             Person?                    @relation("ReservationCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  conflicts               AssetReservationConflict[] @relation("ReservationConflicts")
  conflictingReservations AssetReservationConflict[] @relation("ConflictingReservations")

  // Indexes
  @@index([assetId])
  @@index([reservedForPersonId])
  @@index([reservedForOrgUnitId])
  @@index([reservedById])
  @@index([status])
  @@index([startDate, endDate])
  @@index([status, assetId]) // CRITICAL: Asset availability checks
  @@map("asset_reservations")
}

// AssetReservationConflict model
// Tracks conflicts between overlapping reservations
model AssetReservationConflict {
  id                       String    @id @default(cuid())
  reservationId            String    @map("reservation_id")
  conflictingReservationId String    @map("conflicting_reservation_id")
  detectedAt               DateTime  @default(now()) @map("detected_at")
  resolvedAt               DateTime? @map("resolved_at")
  resolutionNote           String?   @map("resolution_note") @db.Text

  // Relations
  reservation            AssetReservation @relation("ReservationConflicts", fields: [reservationId], references: [id], onDelete: Cascade)
  conflictingReservation AssetReservation @relation("ConflictingReservations", fields: [conflictingReservationId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([reservationId])
  @@index([conflictingReservationId])
  @@index([resolvedAt])
  @@map("asset_reservation_conflicts")
}

// ============================================
// SERVICE MANAGEMENT (LAYER 2)
// ============================================

// BusinessProcess model
// Maps services to business processes for alignment
model BusinessProcess {
  id          String    @id @default(cuid())
  code        String    @unique // "DIGITAL_PAYMENTS", "IDENTITY_MGMT"
  name        String // "Digital Payments", "Identity Management"
  description String?   @db.Text
  category    String? // "Core Banking", "Channels", "Infrastructure"
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  services Service[]

  // Indexes
  @@index([code])
  @@index([category])
  @@map("business_processes")
}

// Service model
// Central IT service catalog (applications, infrastructure, databases, APIs, etc.)
model Service {
  id                      String                   @id @default(cuid())
  // Core Identity
  name                    String                   @unique // "Core Wallet Service", "Active Directory"
  serviceType             ServiceType
  description             String?                  @db.Text
  businessPurpose         String?                  @db.Text // Business value/need
  // Technical Details
  gitlabRepoUrl           String?
  // Classification (NDMO Framework)
  dataConfidentiality     DataConfidentiality      @default(INTERNAL)
  businessImpactLevel     BusinessImpactLevel      @default(MEDIUM)
  criticality             CriticalityLevel         @default(MEDIUM)
  isEssentialService      Boolean                  @default(false) // Core Banking/Payments flag
  // Lifecycle
  deploymentDate          DateTime?
  currentStatus           ServiceStatus            @default(PRODUCTION)
  lastPatchDate           DateTime?
  plannedDecommissionDate DateTime?
  // Vendor/Supplier
  vendorId                String?
  vendor                  Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  slaDetails              Json? // SLA terms, support details
  // Business Alignment
  businessProcessId       String?
  businessProcess         BusinessProcess?         @relation(fields: [businessProcessId], references: [id], onDelete: SetNull)
  // Governance
  isInCentralRegister     Boolean                  @default(true)
  complianceNotes         String?                  @db.Text
  // Metadata
  metadata                Json?
  // Audit
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  createdBy               String?
  updatedBy               String?
  // Relations
  owners                  ServiceOwnership[]
  infrastructure          ServiceInfrastructure[]
  assets                  ServiceAsset[]
  outgoingRelationships   ServiceRelationship[]    @relation("ServiceRelationshipFrom")
  incomingRelationships   ServiceRelationship[]    @relation("ServiceRelationshipTo")

  // Indexes
  @@index([serviceType])
  @@index([currentStatus])
  @@index([criticality])
  @@index([businessImpactLevel])
  @@index([vendorId])
  @@index([businessProcessId])
  @@index([isEssentialService])
  @@index([plannedDecommissionDate])
  @@map("services")
}

// ServiceOwnership model
// Join table for multiple owners per service (Technical, Product, Business)
model ServiceOwnership {
  id            String        @id @default(cuid())
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  personId      String
  person        Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  ownershipType OwnershipType
  isPrimary     Boolean       @default(false) // One primary owner per type
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Constraints
  @@unique([serviceId, personId, ownershipType])
  @@index([serviceId])
  @@index([personId])
  @@index([ownershipType])
  @@index([isPrimary])
  @@map("service_ownerships")
}

// ServiceInfrastructure model
// Cloud/on-prem infrastructure details for services
model ServiceInfrastructure {
  id                   String          @id @default(cuid())
  serviceId            String
  service              Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // Location
  location             ServiceLocation
  // Cloud Provider Details
  cloudProvider        String? // "OCI", "GCP", "AWS"
  compartment          String? // OCI compartment
  project              String? // GCP project
  region               String? // "Riyadh", "Frankfurt", "Mumbai"
  // Network
  ipAddress            String?
  hostname             String?
  // Backup
  backupEnabled        Boolean         @default(false)
  backupSchedule       String? // "daily", "weekly"
  lastBackupDate       DateTime?
  // Additional Details
  cloudProviderDetails Json? // Provider-specific metadata
  // Audit
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Indexes
  @@index([serviceId])
  @@index([location])
  @@index([cloudProvider])
  @@index([region])
  @@map("service_infrastructure")
}

// ServiceAsset model
// Many-to-many relationship between services and assets
model ServiceAsset {
  id           String            @id @default(cuid())
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assetId      String? // Nullable for third-party services
  asset        Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  relationship AssetRelationship
  description  String?           @db.Text // Describe the relationship
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Indexes
  @@index([serviceId])
  @@index([assetId])
  @@index([relationship])
  @@map("service_assets")
}

// ServiceRelationship model
// Service-to-service dependencies for microservices architecture
model ServiceRelationship {
  id               String                  @id @default(cuid())
  fromServiceId    String                  @map("from_service_id")
  toServiceId      String                  @map("to_service_id")
  relationshipType ServiceRelationshipType @map("relationship_type")
  isCritical       Boolean                 @default(false) @map("is_critical")
  description      String?                 @db.Text
  metadata         Json?
  isActive         Boolean                 @default(true) @map("is_active")
  validFrom        DateTime                @default(now()) @map("valid_from")
  validTo          DateTime?               @map("valid_to")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  // Relations
  fromService Service @relation("ServiceRelationshipFrom", fields: [fromServiceId], references: [id], onDelete: Restrict)
  toService   Service @relation("ServiceRelationshipTo", fields: [toServiceId], references: [id], onDelete: Restrict)

  // Unique constraint: prevent duplicate relationships of same type
  @@unique([fromServiceId, toServiceId, relationshipType])

  // Indexes
  @@index([fromServiceId])
  @@index([toServiceId])
  @@index([relationshipType])
  @@index([isActive])
  @@index([isCritical])
  @@index([fromServiceId, isActive])
  @@index([toServiceId, isActive])
  @@map("service_relationships")
}

// ============================================
// CONTRACTS, WARRANTIES, LICENSES
// ============================================

// ContractType model
model ContractType {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  contracts Contract[]

  // Indexes
  @@index([code])
  @@index([isActive])
  @@map("contract_types")
}

// Contract model
model Contract {
  id             String    @id @default(cuid())
  contractTypeId String
  vendorId       String
  name           String
  contractNumber String?   @unique
  startDate      DateTime
  endDate        DateTime?
  autoRenew      Boolean   @default(false)
  renewalTerms   String?   @db.Text
  slaDefinition  Json? // SLA rules
  totalValue     Decimal?  @db.Decimal(12, 2)
  totalValueSar  Decimal?  @db.Decimal(12, 2) // Frozen SAR snapshot at create/update
  currency       String?
  note           String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  contractType        ContractType           @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)
  vendor              Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assets              Asset[]
  linkedObjects       ContractLinkedObject[]
  licenseEntitlements LicenseEntitlement[]

  // Indexes
  @@index([contractTypeId])
  @@index([vendorId])
  @@index([contractNumber])
  @@index([startDate, endDate])
  @@map("contracts")
}

// ContractLinkedObject model
// Polymorphic relation: targetType + targetId handled at application level
model ContractLinkedObject {
  id         String               @id @default(cuid())
  contractId String
  targetType TargetObjectTypeEnum
  targetId   String // CI.id / Asset.id / LicenseEntitlement.id (no FK - polymorphic)
  note       String?              @db.Text
  createdAt  DateTime             @default(now())

  // Relations
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([contractId])
  @@index([targetType, targetId])
  @@map("contract_linked_objects")
}

// LicenseProduct model
model LicenseProduct {
  id               String   @id @default(cuid())
  name             String   @unique
  code             String   @unique
  vendorId         String
  metricType       String // per_device, per_user, per_core, per_vm, per_cluster
  description      String?  @db.Text
  lifecycleModelId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  vendor              Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lifecycleModel      LifecycleModel?       @relation(fields: [lifecycleModelId], references: [id], onDelete: SetNull)
  fields              LicenseProductField[]
  licenseEntitlements LicenseEntitlement[]
  addons              LicenseAddon[]

  // Indexes
  @@index([code])
  @@index([vendorId])
  @@index([lifecycleModelId])
  @@map("license_products")
}

// LicenseProductField model
model LicenseProductField {
  id                String   @id @default(cuid())
  licenseProductId  String
  fieldDefinitionId String
  isRequired        Boolean  @default(false)
  isVisible         Boolean  @default(true)
  uiOrder           Int      @default(0)
  defaultValue      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  licenseProduct  LicenseProduct  @relation(fields: [licenseProductId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([licenseProductId, fieldDefinitionId])
  @@index([licenseProductId])
  @@index([fieldDefinitionId])
  @@map("license_product_fields")
}

// LicenseEntitlement model
model LicenseEntitlement {
  id                String    @id @default(cuid())
  licenseProductId  String
  contractId        String?
  purchasedQuantity Int
  effectiveStart    DateTime
  effectiveEnd      DateTime?
  allowedScope      Json? // e.g. regions, departments, environments
  note              String?   @db.Text
  unitCost          Decimal?  @db.Decimal(12, 2) // Cost per license unit
  currency          String? // ISO 3-letter currency code (USD, SAR, etc.)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  licenseProduct    LicenseProduct            @relation(fields: [licenseProductId], references: [id], onDelete: Restrict)
  contract          Contract?                 @relation(fields: [contractId], references: [id], onDelete: SetNull)
  allocations       LicenseAllocation[]
  entitlementAddons LicenseEntitlementAddon[]

  // Indexes
  @@index([licenseProductId])
  @@index([contractId])
  @@index([effectiveStart, effectiveEnd])
  @@map("license_entitlements")
}

// LicenseAllocation model
// Polymorphic relation: targetType + targetId handled at application level
model LicenseAllocation {
  id                   String                   @id @default(cuid())
  licenseEntitlementId String
  targetType           AllocationTargetTypeEnum
  targetId             String // Person.id / ConfigurationItem.id / Asset.id (no FK - polymorphic)
  allocatedQuantity    Int
  allocatedAt          DateTime                 @default(now())
  deallocatedAt        DateTime?
  note                 String?                  @db.Text
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  // Relations
  licenseEntitlement LicenseEntitlement @relation(fields: [licenseEntitlementId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([licenseEntitlementId])
  @@index([targetType, targetId])
  @@index([allocatedAt])
  @@index([deallocatedAt]) // Medium-priority: Deallocation tracking
  @@map("license_allocations")
}

// LicenseAddon model - product-level addon templates (e.g., premium support, training)
model LicenseAddon {
  id               String   @id @default(cuid())
  licenseProductId String
  name             String
  code             String
  description      String?  @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  licenseProduct LicenseProduct            @relation(fields: [licenseProductId], references: [id], onDelete: Cascade)
  entitlements   LicenseEntitlementAddon[]

  // Indexes
  @@unique([licenseProductId, code])
  @@index([licenseProductId])
  @@index([isActive])
  @@map("license_addons")
}

// LicenseEntitlementAddon model - junction table linking addons to entitlements with cost
model LicenseEntitlementAddon {
  id                   String   @id @default(cuid())
  licenseEntitlementId String
  licenseAddonId       String
  cost                 Decimal? @db.Decimal(12, 2) // Cost for this addon on this entitlement
  currency             String? // ISO 3-letter currency code
  note                 String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  licenseEntitlement LicenseEntitlement @relation(fields: [licenseEntitlementId], references: [id], onDelete: Cascade)
  licenseAddon       LicenseAddon       @relation(fields: [licenseAddonId], references: [id], onDelete: Cascade)

  // Indexes
  @@unique([licenseEntitlementId, licenseAddonId])
  @@index([licenseEntitlementId])
  @@index([licenseAddonId])
  @@map("license_entitlement_addons")
}

