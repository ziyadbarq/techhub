// ============================================
// SERVICE MANAGEMENT
// ============================================
//
// Models: BusinessProcess, Service, ServiceOwnership, ServiceInfrastructure, ServiceAsset, ServiceRelationship, ServiceHealthHistory, ServiceSlaMetric
// Enums: ServiceType, ServiceStatus, DataConfidentiality, BusinessImpactLevel, CriticalityLevel, OwnershipType, ServiceLocation, AssetRelationship, ServiceRelationshipType, ServiceHealthStatus, SlaComplianceStatus, SlaMetricType
// Layer: Layer 3 (Advanced ITAM)
// Related DI Module: service.module.ts
// ============================================

// BusinessProcess model
// Maps services to business processes for alignment
model BusinessProcess {
  id          String    @id @default(cuid())
  code        String    @unique // "DIGITAL_PAYMENTS", "IDENTITY_MGMT"
  name        String // "Digital Payments", "Identity Management"
  description String?   @db.Text
  category    String? // "Core Banking", "Channels", "Infrastructure"
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  services Service[]

  // Indexes
  @@index([code])
  @@index([category])
  @@map("business_processes")
}

// Service model
// Central IT service catalog (applications, infrastructure, databases, APIs, etc.)
model Service {
  id                      String                   @id @default(cuid())
  // Core Identity
  name                    String                   @unique // "Core Wallet Service", "Active Directory"
  serviceType             ServiceType
  description             String?                  @db.Text
  businessPurpose         String?                  @db.Text // Business value/need
  // Technical Details
  gitlabRepoUrl           String?
  url                     String? // Primary service URL (web interface, API endpoint, etc.)
  supportContact          String? // General support contact (email or phone)
  supportHours            String? // e.g., "24/7", "Mon-Fri 9AM-5PM SAT", "Business Hours"
  // Classification (NDMO Framework)
  dataConfidentiality     DataConfidentiality      @default(INTERNAL)
  businessImpactLevel     BusinessImpactLevel      @default(MEDIUM)
  criticality             CriticalityLevel         @default(MEDIUM)
  isEssentialService      Boolean                  @default(false) // Core Banking/Payments flag
  // Lifecycle
  deploymentDate          DateTime?
  currentStatus           ServiceStatus            @default(PRODUCTION)
  lastPatchDate           DateTime?
  plannedDecommissionDate DateTime?
  // Vendor/Supplier
  vendorId                String?
  vendor                  Vendor?                  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  slaDetails              Json? // SLA terms, support details
  // Business Alignment
  businessProcessId       String?
  businessProcess         BusinessProcess?         @relation(fields: [businessProcessId], references: [id], onDelete: SetNull)
  // Governance
  isInCentralRegister     Boolean                  @default(true)
  complianceNotes         String?                  @db.Text
  // Metadata
  metadata                Json?
  // Audit
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  createdBy               String?
  updatedBy               String?

  // ============ SLA FIELDS (Structured) ============
  // Response time SLAs (in milliseconds)
  slaResponseTimeP50         Int? // P50 response time target (ms)
  slaResponseTimeP95         Int? // P95 response time target (ms)
  slaResponseTimeP99         Int? // P99 response time target (ms)
  // Resolution time SLAs (in minutes)
  slaResolutionTimeCritical  Int? // Critical incident resolution (minutes)
  slaResolutionTimeHigh      Int? // High priority resolution (minutes)
  slaResolutionTimeMedium    Int? // Medium priority resolution (minutes)
  // Uptime SLA (percentage, stored as decimal: 99.9 = 99.9%)
  slaUptimePercentage        Decimal?                @db.Decimal(5, 3) // e.g., 99.900
  // Error rate threshold (percentage)
  slaErrorRateThreshold      Decimal?                @db.Decimal(5, 3) // e.g., 1.000 for 1%
  // SLA compliance tracking
  slaComplianceStatus        SlaComplianceStatus     @default(NOT_APPLICABLE)
  lastSlaReviewDate          DateTime?
  slaViolationCount          Int                     @default(0)
  // Support tiers (from old slaDetails JSON)
  slaSupportTier             String? // "24/7", "Business Hours", "Best Effort"
  slaContactEmail            String?
  slaEscalationPath          String?                 @db.Text
  // ============ HEALTH MONITORING FIELDS ============
  healthStatus               ServiceHealthStatus     @default(UNKNOWN)
  lastHealthCheck            DateTime?
  nextScheduledHealthCheck   DateTime?
  // Uptime tracking (calculated fields)
  uptimePercentage24h        Decimal?                @db.Decimal(5, 3) // Last 24 hours
  uptimePercentage7d         Decimal?                @db.Decimal(5, 3) // Last 7 days
  uptimePercentage30d        Decimal?                @db.Decimal(5, 3) // Last 30 days
  // Monitoring configuration
  healthCheckUrl             String? // HTTP endpoint for health checks
  healthCheckInterval        Int? // Check interval in minutes
  healthCheckTimeout         Int? // Timeout in seconds
  healthCheckEnabled         Boolean                 @default(false)
  // Performance metrics (recent)
  currentResponseTimeP50     Int? // Current P50 (ms)
  currentResponseTimeP95     Int? // Current P95 (ms)
  currentErrorRate           Decimal?                @db.Decimal(5, 3) // Current error rate %
  // Incident tracking
  lastIncidentDate           DateTime?
  lastDowntimeDate           DateTime?
  lastDowntimeDuration       Int? // Minutes
  mttrMinutes                Int? // Mean Time To Recover
  mtbfHours                  Int? // Mean Time Between Failures

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  owners                  ServiceOwnership[]
  infrastructure          ServiceInfrastructure[]
  assets                  ServiceAsset[]
  outgoingRelationships   ServiceRelationship[]    @relation("ServiceRelationshipFrom")
  incomingRelationships   ServiceRelationship[]    @relation("ServiceRelationshipTo")
  healthHistory           ServiceHealthHistory[]
  slaMetrics              ServiceSlaMetric[]
  deletedBy               Person?                  @relation("ServiceDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([serviceType])
  @@index([currentStatus])
  @@index([criticality])
  @@index([businessImpactLevel])
  @@index([vendorId])
  @@index([businessProcessId])
  @@index([isEssentialService])
  @@index([plannedDecommissionDate])
  @@index([deletedAt])
  @@index([healthStatus])
  @@index([slaComplianceStatus])
  @@index([lastHealthCheck])
  @@index([healthCheckEnabled])
  @@map("services")
}

// ServiceOwnership model
// Join table for multiple owners per service (Technical, Product, Business)
model ServiceOwnership {
  id            String        @id @default(cuid())
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  personId      String
  person        Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  ownershipType OwnershipType
  isPrimary     Boolean       @default(false) // One primary owner per type
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Constraints
  @@unique([serviceId, personId, ownershipType])
  @@index([serviceId])
  @@index([personId])
  @@index([ownershipType])
  @@index([isPrimary])
  @@map("service_ownerships")
}

// ServiceInfrastructure model
// Cloud/on-prem infrastructure details for services
model ServiceInfrastructure {
  id                   String          @id @default(cuid())
  serviceId            String
  service              Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // Location
  location             ServiceLocation
  // Cloud Provider Details
  cloudProvider        String? // "OCI", "GCP", "AWS"
  compartment          String? // OCI compartment
  project              String? // GCP project
  region               String? // "Riyadh", "Frankfurt", "Mumbai"
  // Network
  ipAddress            String?
  hostname             String?
  // Backup
  backupEnabled        Boolean         @default(false)
  backupSchedule       String? // "daily", "weekly"
  lastBackupDate       DateTime?
  // Additional Details
  cloudProviderDetails Json? // Provider-specific metadata
  // Audit
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Indexes
  @@index([serviceId])
  @@index([location])
  @@index([cloudProvider])
  @@index([region])
  @@map("service_infrastructure")
}

// ServiceAsset model
// Many-to-many relationship between services and assets
model ServiceAsset {
  id           String            @id @default(cuid())
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  assetId      String? // Nullable for third-party services
  asset        Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  relationship AssetRelationship
  description  String?           @db.Text // Describe the relationship
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Indexes
  @@unique([serviceId, assetId, relationship])
  @@index([serviceId])
  @@index([assetId])
  @@index([relationship])
  @@map("service_assets")
}

// ServiceRelationship model
// Service-to-service dependencies for microservices architecture
model ServiceRelationship {
  id               String                  @id @default(cuid())
  fromServiceId    String
  toServiceId      String
  relationshipType ServiceRelationshipType
  isCritical       Boolean                 @default(false)
  description      String?                 @db.Text
  metadata         Json?
  isActive         Boolean                 @default(true)
  validFrom        DateTime                @default(now())
  validTo          DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Relations
  fromService Service @relation("ServiceRelationshipFrom", fields: [fromServiceId], references: [id], onDelete: Restrict)
  toService   Service @relation("ServiceRelationshipTo", fields: [toServiceId], references: [id], onDelete: Restrict)

  // Unique constraint: prevent duplicate relationships of same type
  @@unique([fromServiceId, toServiceId, relationshipType])

  // Indexes
  @@index([fromServiceId])
  @@index([toServiceId])
  @@index([relationshipType])
  @@index([isActive])
  @@index([isCritical])
  @@index([fromServiceId, isActive])
  @@index([toServiceId, isActive])
  @@map("service_relationships")
}

// ServiceHealthHistory model
// Track historical health status changes for services
model ServiceHealthHistory {
  id             String              @id @default(cuid())
  serviceId      String
  service        Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  previousStatus ServiceHealthStatus
  newStatus      ServiceHealthStatus
  checkTimestamp DateTime            @default(now())
  // Health check details
  responseTime   Int? // ms
  errorMessage   String?             @db.Text
  statusCode     Int? // HTTP status code
  checkDuration  Int? // ms
  // Metadata
  triggeredBy    String? // "automated", "manual", "alert"
  metadata       Json?
  createdAt      DateTime            @default(now())

  // Indexes
  @@index([serviceId, checkTimestamp])
  @@index([newStatus])
  @@map("service_health_history")
}

// ServiceSlaMetric model
// Track SLA performance metrics over time
model ServiceSlaMetric {
  id               String              @id @default(cuid())
  serviceId        String
  service          Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  metricType       SlaMetricType
  periodStart      DateTime
  periodEnd        DateTime
  // Metric values
  targetValue      Decimal             @db.Decimal(12, 3)
  actualValue      Decimal             @db.Decimal(12, 3)
  complianceStatus SlaComplianceStatus
  // Additional context
  breachDuration   Int? // Minutes of breach
  incidentCount    Int                 @default(0)
  notes            String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Constraints and indexes
  @@unique([serviceId, metricType, periodStart])
  @@index([serviceId, periodStart])
  @@index([complianceStatus])
  @@index([metricType])
  @@map("service_sla_metrics")
}

// ============================================
// SERVICE MANAGEMENT ENUMS
// ============================================

// Service type classification
enum ServiceType {
  APPLICATION
  SERVER
  NETWORK
  DATABASE
  ENDPOINT
  CLOUD_SERVICE
  API
  MIDDLEWARE
  STORAGE
  OTHER
}

// Service environment/status
enum ServiceStatus {
  PRODUCTION
  UAT
  DR
  DEVELOPMENT
  RETIRED
  PLANNED
}

// Data confidentiality level (NDMO Framework)
enum DataConfidentiality {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

// Business impact level from BIA
enum BusinessImpactLevel {
  HIGH
  MEDIUM
  LOW
}

// Service criticality level
enum CriticalityLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// Service ownership type (multiple owners per service)
enum OwnershipType {
  TECHNICAL // Technical Owner - engineers, architects
  PRODUCT // Product Owner - product managers
  BUSINESS // Business Owner - business stakeholders
}

// Infrastructure location
enum ServiceLocation {
  ON_PREM
  OCI_CLOUD
  GCP_CLOUD
  AWS_CLOUD
  HYBRID
}

// Asset relationship to service
enum AssetRelationship {
  HOSTS // Asset hosts the service (server runs application)
  SUPPORTS // Asset supports the service (database for app)
  DEPENDS_ON // Service depends on asset
  MONITORS // Asset monitors the service
  BACKS_UP // Asset backs up the service
}

// Service-to-service relationship types
enum ServiceRelationshipType {
  DEPENDS_ON // Service A depends on Service B
  CALLS // Service A calls Service B (API/RPC)
  PUBLISHES_EVENTS_TO // Service A publishes events to Service B
  CONSUMES_EVENTS_FROM // Service A consumes events from Service B
  BACKUP_FOR // Service A is backup for Service B
}

// Service health status
enum ServiceHealthStatus {
  HEALTHY // All checks passing
  DEGRADED // Some issues, partial functionality
  UNHEALTHY // Critical issues, service impaired
  DOWN // Service unavailable
  UNKNOWN // Health check not configured or failed
  MAINTENANCE // Planned maintenance mode
}

// SLA compliance status
enum SlaComplianceStatus {
  COMPLIANT // Meeting all SLA targets
  AT_RISK // Approaching SLA thresholds
  BREACHED // SLA violated
  NOT_APPLICABLE // No SLA defined
}

// SLA metric types
enum SlaMetricType {
  RESPONSE_TIME // P50/P95/P99 response time
  RESOLUTION_TIME // Time to resolve incidents
  UPTIME // Availability percentage
  ERROR_RATE // Error rate threshold
  THROUGHPUT // Request/transaction volume
}
