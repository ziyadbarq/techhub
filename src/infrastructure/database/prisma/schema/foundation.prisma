// ============================================
// FOUNDATION LAYER - Organization, People, Locations, Vendors, Lifecycle
// ============================================
//
// Models: OrganizationUnit, Person, Location, Vendor, VendorContact, ExchangeRate, LifecycleModel, LifecycleState, LifecycleTransition, FieldDefinition
// Enums: OrganizationUnitType, VendorType, LocationType, StateType
// Layer: Layer 1 (Foundation)
// Related DI Module: foundation.module.ts
// ============================================

// OrganizationUnit model
// Hierarchy: Company > Business Unit > Department > Team
model OrganizationUnit {
  id          String               @id @default(cuid())
  parentId    String?
  name        String
  code        String               @unique
  description String?              @db.Text
  unitType    OrganizationUnitType @default(OTHER)
  managerId   String?
  costCenter  String?
  level       Int // 1=Company, 2=BU, 3=Dept, 4=Team
  isActive    Boolean              @default(true)
  note        String?              @db.Text
  metadata    Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  parent             OrganizationUnit?   @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           OrganizationUnit[]  @relation("OrgUnitHierarchy")
  manager            Person?             @relation("OrgUnitManager", fields: [managerId], references: [id], onDelete: SetNull)
  people             Person[]            @relation("PersonOrgUnit")
  configurationItems ConfigurationItem[]
  dataOwnerships     DataOwnership[]     @relation("DataOwnershipOrgUnit")
  reservations       AssetReservation[]  @relation("ReservationForOrgUnit")
  deletedBy          Person?             @relation("OrgUnitDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([parentId])
  @@index([code])
  @@index([managerId])
  @@index([isActive])
  @@index([level])
  @@index([unitType])
  @@index([deletedAt])
  @@map("organization_units")
}

// Person model
// Organizational people (different from Better Auth User)
model Person {
  id              String    @id @default(cuid())
  azureAdId       String?   @unique // Immutable MS Graph ID - source of truth for user sync
  userId          String?   @unique // Optional link to Better Auth User
  firstName       String
  lastName        String
  middleName      String?
  email           String    @unique
  phone           String?
  mobile          String?
  employeeId      String?   @unique
  orgUnitId       String
  managerId       String?
  title           String?
  office          String? // Office location from MS Graph (e.g., "Riyadh HQ", "India Office")
  locationId      String?
  department      String?
  hireDate        DateTime?
  terminationDate DateTime?
  isActive        Boolean   @default(true)
  isExcluded      Boolean   @default(false) // TechHub-specific: hide from app (service accounts)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Audit trail fields
  createdById String?
  updatedById String?

  // Relations
  user                         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgUnit                      OrganizationUnit       @relation("PersonOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  manager                      Person?                @relation("PersonManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports                Person[]               @relation("PersonManager")
  location                     Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  managedOrgUnits              OrganizationUnit[]     @relation("OrgUnitManager")
  configurationItems           ConfigurationItem[]
  stockMovementsPerformed      StockMovement[]        @relation("StockMovementPerformedBy")
  stockMovementsVoided         StockMovement[]        @relation("StockMovementVoidedBy")
  verificationCampaigns        VerificationCampaign[]
  verificationItems            VerificationItem[]
  auditLogsChanged             AuditLogEntry[]        @relation("AuditLogChangedBy")
  attachments                  Attachment[]
  dataOwnerships               DataOwnership[]        @relation("DataOwnershipPerson")
  assignedMaintenanceSchedules MaintenanceSchedule[]
  performedMaintenanceRecords  MaintenanceRecord[]
  initiatedDisposals           AssetDisposal[]        @relation("DisposalInitiatedBy")
  approvedDisposals            AssetDisposal[]        @relation("DisposalApprovedBy")
  disposalApprovals            DisposalApproval[]     @relation("DisposalApprover")
  uploadedDisposalDocuments    DisposalDocument[]     @relation("DisposalDocumentUploader")
  kitCheckouts                 AssetKitCheckout[]     @relation("KitCheckoutBy")
  reservationsFor              AssetReservation[]     @relation("ReservationForPerson")
  reservationsCreated          AssetReservation[]     @relation("ReservationBy")
  reservationsConfirmed        AssetReservation[]     @relation("ReservationConfirmedBy")
  reservationsCancelled        AssetReservation[]     @relation("ReservationCancelledBy")
  serviceOwnerships            ServiceOwnership[]
  intuneDevices                IntuneDevice[]         @relation("IntuneDevicePerson")
  deletedFieldDefinitions      FieldDefinition[]      @relation("FieldDefinitionDeletedBy")
  archivedFieldDefinitions     FieldDefinition[]      @relation("FieldDefinitionArchivedBy")
  createdFieldTemplates        FieldTemplate[]        @relation("FieldTemplateCreatedBy")
  // Self-referential soft delete and audit relations
  deletedBy                    Person?                @relation("PersonDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  deletedPersons               Person[]               @relation("PersonDeletedBy")
  createdBy                    Person?                @relation("PersonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdPersons               Person[]               @relation("PersonCreatedBy")
  updatedBy                    Person?                @relation("PersonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedPersons               Person[]               @relation("PersonUpdatedBy")
  // Soft delete relations (reverse for other entities)
  deletedOrgUnits              OrganizationUnit[]     @relation("OrgUnitDeletedBy")
  deletedLocations             Location[]             @relation("LocationDeletedBy")
  deletedVendors               Vendor[]               @relation("VendorDeletedBy")
  deletedLifecycleModels       LifecycleModel[]       @relation("LifecycleModelDeletedBy")
  deletedLifecycleStates       LifecycleState[]       @relation("LifecycleStateDeletedBy")
  deletedAssetCategories       AssetCategory[]        @relation("AssetCategoryDeletedBy")
  deletedAssetModels           AssetModel[]           @relation("AssetModelDeletedBy")
  deletedAssets                Asset[]                @relation("AssetDeletedBy")
  createdAssets                Asset[]                @relation("AssetCreatedBy")
  updatedAssets                Asset[]                @relation("AssetUpdatedBy")
  deletedWarranties            Warranty[]             @relation("WarrantyDeletedBy")
  deletedMaintenanceSchedules  MaintenanceSchedule[]  @relation("MaintenanceScheduleDeletedBy")
  deletedContractTypes         ContractType[]         @relation("ContractTypeDeletedBy")
  deletedContracts             Contract[]             @relation("ContractDeletedBy")
  deletedCIClasses             CIClass[]              @relation("CIClassDeletedBy")
  deletedConfigurationItems    ConfigurationItem[]    @relation("ConfigurationItemDeletedBy")
  createdConfigurationItems    ConfigurationItem[]    @relation("ConfigurationItemCreatedBy")
  updatedConfigurationItems    ConfigurationItem[]    @relation("ConfigurationItemUpdatedBy")
  deletedServices              Service[]              @relation("ServiceDeletedBy")
  deletedLicenseProducts       LicenseProduct[]       @relation("LicenseProductDeletedBy")
  deletedLicenseEntitlements   LicenseEntitlement[]   @relation("LicenseEntitlementDeletedBy")
  deletedAssetKits             AssetKit[]             @relation("AssetKitDeletedBy")
  deletedAssetReservations     AssetReservation[]     @relation("AssetReservationDeletedBy")
  reportSchedulesCreated       ReportSchedule[]       @relation("ReportScheduleCreatedBy")

  // Indexes
  @@index([azureAdId])
  @@index([userId])
  @@index([email])
  @@index([employeeId])
  @@index([orgUnitId])
  @@index([managerId])
  @@index([locationId])
  @@index([isActive])
  @@index([isExcluded])
  @@index([deletedAt])
  @@index([firstName, lastName])
  @@map("persons")
}

// Location model
// Hierarchy: Country > City > Campus > Building > Floor > Room > Rack
model Location {
  id           String       @id @default(cuid())
  parentId     String?
  name         String
  code         String       @unique
  description  String?      @db.Text
  locationType LocationType
  address      String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  latitude     Decimal?     @db.Decimal(10, 7)
  longitude    Decimal?     @db.Decimal(10, 7)
  timeZone     String?
  isActive     Boolean      @default(true)
  metadata     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  parent             Location?           @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           Location[]          @relation("LocationHierarchy")
  persons            Person[]
  stockLocations     StockLocation[]
  configurationItems ConfigurationItem[]
  deletedBy          Person?             @relation("LocationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([parentId])
  @@index([code])
  @@index([locationType])
  @@index([city])
  @@index([country])
  @@index([isActive])
  @@index([deletedAt])
  @@map("locations")
}

// Vendor model
model Vendor {
  id           String     @id @default(cuid())
  name         String
  code         String     @unique
  legalName    String?
  description  String?    @db.Text
  vendorType   VendorType @default(OTHER)
  taxId        String?
  website      String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  country      String?
  postalCode   String?
  paymentTerms String?    @db.Text
  isPreferred  Boolean    @default(false)
  isActive     Boolean    @default(true)
  tags         String[]
  note         String?    @db.Text
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  contacts        VendorContact[]
  assetModels     AssetModel[]
  assets          Asset[]
  warranties      Warranty[]
  contracts       Contract[]
  licenseProducts LicenseProduct[]
  disposals       AssetDisposal[]
  services        Service[]
  deletedBy       Person?          @relation("VendorDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([name])
  @@index([code])
  @@index([email])
  @@index([vendorType])
  @@index([isActive])
  @@index([isPreferred])
  @@index([deletedAt])
  @@map("vendors")
}

// VendorContact model
model VendorContact {
  id        String   @id @default(cuid())
  vendorId  String
  firstName String
  lastName  String
  title     String?
  email     String?
  phone     String?
  mobile    String?
  role      String? // Account manager, Support, Sales, etc.
  isPrimary Boolean  @default(false)
  isActive  Boolean  @default(true)
  note      String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  // Indexes
  @@index([vendorId])
  @@index([email])
  @@index([isPrimary])
  @@map("vendor_contacts")
}

// ExchangeRate model
// Multi-currency support - stores exchange rates to SAR (Saudi Riyal)
model ExchangeRate {
  id        String   @id @default(cuid())
  currency  String   @unique // 3-letter ISO code (USD, EUR, GBP, SAR)
  rateToSAR Decimal  @db.Decimal(10, 6) // 1 CURRENCY = X SAR
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([currency])
  @@index([isActive])
  @@map("exchange_rates")
}

// LifecycleModel model
// Reusable state machine definitions (for CIs, Assets, Licenses)
model LifecycleModel {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  states          LifecycleState[]
  transitions     LifecycleTransition[]
  ciClasses       CIClass[]
  assetCategories AssetCategory[]
  licenseProducts LicenseProduct[]
  deletedBy       Person?               @relation("LifecycleModelDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([name])
  @@index([deletedAt])
  @@map("lifecycle_models")
}

// LifecycleState model
model LifecycleState {
  id               String    @id @default(cuid())
  lifecycleModelId String
  name             String
  code             String
  description      String?   @db.Text
  stateType        StateType @default(ACTIVE)
  isActiveState    Boolean   @default(false) // true if considered in-use/active
  isTerminalState  Boolean   @default(false) // true if end-of-life
  sortOrder        Int
  isActive         Boolean   @default(true)
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  lifecycleModel     LifecycleModel        @relation(fields: [lifecycleModelId], references: [id], onDelete: Restrict)
  transitionsFrom    LifecycleTransition[] @relation("TransitionFrom")
  transitionsTo      LifecycleTransition[] @relation("TransitionTo")
  configurationItems ConfigurationItem[]
  assets             Asset[]
  deletedBy          Person?               @relation("LifecycleStateDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@unique([lifecycleModelId, code])
  @@index([lifecycleModelId])
  @@index([code])
  @@index([sortOrder])
  @@index([stateType])
  @@index([deletedAt])
  @@map("lifecycle_states")
}

// LifecycleTransition model
model LifecycleTransition {
  id               String   @id @default(cuid())
  lifecycleModelId String
  name             String
  description      String?  @db.Text
  fromStateId      String
  toStateId        String
  requiredRoleId   String? // Optional: role required to execute transition
  requiresApproval Boolean  @default(false)
  approvalPolicy   Json? // JSON rule definition
  conditions       Json?
  isAutomated      Boolean  @default(false)
  isActive         Boolean  @default(true)
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  lifecycleModel LifecycleModel @relation(fields: [lifecycleModelId], references: [id], onDelete: Restrict)
  fromState      LifecycleState @relation("TransitionFrom", fields: [fromStateId], references: [id], onDelete: Restrict)
  toState        LifecycleState @relation("TransitionTo", fields: [toStateId], references: [id], onDelete: Restrict)
  requiredRole   Role?          @relation("TransitionRequiredRole", fields: [requiredRoleId], references: [id], onDelete: SetNull)

  // Indexes
  @@unique([lifecycleModelId, fromStateId, toStateId])
  @@index([lifecycleModelId])
  @@index([fromStateId])
  @@index([toStateId])
  @@index([requiredRoleId])
  @@map("lifecycle_transitions")
}

// FieldDefinition model
// Meta-model for dynamic attributes
model FieldDefinition {
  id               String            @id @default(cuid())
  name             String            @unique // internal name, e.g. cpu_cores
  label            String // display label
  dataType         FieldDataTypeEnum
  description      String?           @db.Text
  entityType       String
  isGlobal         Boolean           @default(false) // true if reusable across many domains
  isRequired       Boolean           @default(false)
  isUnique         Boolean           @default(false)
  validationRules  Json? // min/max, regex, etc.
  defaultValue     Json?
  enumOptions      Json? // for ENUM data_type
  conditionalLogic Json? // visibility, required, disabled conditions based on other fields
  uiGroup          String? // group/tab in UI
  uiOrder          Int               @default(0)
  displayOrder     Int               @default(0)
  isSearchable     Boolean           @default(false)
  isFilterable     Boolean           @default(false)
  isActive         Boolean           @default(true)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Archive fields (for unused but preserved fields)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?   @db.Text

  // Relations
  ciClassFields        CIClassField[]
  assetCategoryFields  AssetCategoryField[]
  licenseProductFields LicenseProductField[]
  templateItems        FieldTemplateItem[]
  deletedBy            Person?               @relation("FieldDefinitionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  archivedBy           Person?               @relation("FieldDefinitionArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([name])
  @@index([dataType])
  @@index([entityType])
  @@index([isGlobal])
  @@index([isActive])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("field_definitions")
}

// FieldTemplate model
// Pre-built templates for common field configurations
model FieldTemplate {
  id          String   @id @default(cuid())
  name        String   @unique // Display name: "Laptop Standard Fields"
  code        String   @unique // Internal code: "LAPTOP_STANDARD"
  description String?  @db.Text
  entityType  String // "Asset", "ConfigurationItem", etc.
  category    String? // Asset type category: "LAPTOP", "SERVER", "NETWORK_DEVICE"
  standard    String? // "ITIL", "NIST", "ISO27001", "CUSTOM"
  isBuiltIn   Boolean  @default(false) // System-provided vs user-created
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  items     FieldTemplateItem[]
  createdBy Person?             @relation("FieldTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([entityType])
  @@index([category])
  @@index([standard])
  @@index([isBuiltIn])
  @@index([isActive])
  @@map("field_templates")
}

// FieldTemplateItem model
// Individual fields within a template
model FieldTemplateItem {
  id                String            @id @default(cuid())
  fieldTemplateId   String
  fieldDefinitionId String? // Optional link to existing FieldDefinition
  fieldName         String // Internal name (snake_case)
  fieldLabel        String // Display label
  fieldDataType     FieldDataTypeEnum
  description       String?           @db.Text
  isRequired        Boolean           @default(false)
  isUnique          Boolean           @default(false)
  validationRules   Json?
  defaultValue      Json?
  enumOptions       Json?
  uiOrder           Int               @default(0)
  uiGroup           String?
  isSearchable      Boolean           @default(false)
  isFilterable      Boolean           @default(false)
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  fieldTemplate   FieldTemplate    @relation(fields: [fieldTemplateId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition? @relation(fields: [fieldDefinitionId], references: [id], onDelete: SetNull)

  // Indexes
  @@unique([fieldTemplateId, fieldName])
  @@index([fieldTemplateId])
  @@index([fieldDefinitionId])
  @@index([uiOrder])
  @@map("field_template_items")
}

// ============================================
// FOUNDATION ENUMS
// ============================================

enum OrganizationUnitType {
  COMPANY
  BUSINESS_UNIT
  DEPARTMENT
  TEAM
  DIVISION
  OTHER
}

enum VendorType {
  MANUFACTURER
  RESELLER
  SERVICE_PROVIDER
  CONSULTANT
  CONTRACTOR
  OTHER
}

enum LocationType {
  COUNTRY
  CITY
  CAMPUS
  BUILDING
  FLOOR
  ROOM
  RACK
  DATA_CENTER
  CLOUD_REGION
  PHYSICAL
  LOGICAL
  ZONE
  AREA
}

enum StateType {
  INITIAL
  ACTIVE
  INACTIVE
  TERMINAL
  TRANSITION
}
