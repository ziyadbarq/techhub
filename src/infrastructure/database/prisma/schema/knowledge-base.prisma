// Knowledge Base: policies, PDFs and structured internal documentation.
// PDF bytes are stored privately in GCS; the database records only opaque keys.
// Never serve GCS object URLs or render untrusted HTML.
model KnowledgeArticle {
  id                      String   @id @default(cuid())
  title                   String
  summary                 String?  @db.Text
  category                String   @default("GENERAL")
  classification          String   @default("INTERNAL")
  sourceType              String   @default("EDITOR")
  blocks                  Json?
  plainText               String?  @db.Text
  filePath                String?
  fileName                String?
  fileSize                Int?
  version                 Int      @default(1)
  publishedVersion        Int?
  folderId                String?
  requiresAcknowledgement Boolean  @default(false)
  isArchived              Boolean  @default(false)
  createdById             String
  updatedById             String
  publishedAt             DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  folder    KnowledgeFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  revisions KnowledgeRevision[]
  acknowledgements KnowledgeAcknowledgement[]

  @@index([category, classification])
  @@index([publishedVersion, isArchived])
  @@index([folderId, updatedAt])
  @@index([updatedAt])
  @@map("knowledge_articles")
}

model KnowledgeRevision {
  id                      String   @id @default(cuid())
  articleId               String
  version                 Int
  title                   String
  summary                 String?  @db.Text
  category                String
  classification          String
  sourceType              String
  blocks                  Json?
  plainText               String?  @db.Text
  filePath                String?
  fileName                String?
  fileSize                Int?
  requiresAcknowledgement Boolean
  editedById              String
  createdAt               DateTime @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version])
  @@index([articleId, createdAt])
  @@map("knowledge_revisions")
}

model KnowledgeAcknowledgement {
  id             String   @id @default(cuid())
  articleId      String
  version        Int
  userId         String
  acknowledgedAt DateTime @default(now())

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, version, userId])
  @@index([userId, acknowledgedAt])
  @@map("knowledge_acknowledgements")
}


// Folder location is mutable metadata; it never changes article revision history.
model KnowledgeFolder {
  id          String   @id @default(cuid())
  name        String
  parentId    String?
  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   KnowledgeFolder?  @relation("KnowledgeFolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children KnowledgeFolder[] @relation("KnowledgeFolderTree")
  articles KnowledgeArticle[]

  @@unique([parentId, name])
  @@index([parentId])
  @@map("knowledge_folders")
}
