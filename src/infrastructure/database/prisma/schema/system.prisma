// ============================================
// SYSTEM MODELS (Tasks, Feature Flags)
// ============================================
//
// Models: Task, FeatureFlag, FeatureFlagAuditLog
// Enums: TaskStatus, FeatureFlagCategory, FeatureFlagAction
// Layer: System (Cross-cutting)
// Related DI Module: Various system modules
// ============================================

// ============================================
// TASK MODEL (Example CRUD - kept as reference)
// ============================================

// Task model
// Demonstrates Clean Architecture CRUD patterns
model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(PENDING)
  createdBy   String? // User ID of task creator (for ownership checks)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Indexes
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([createdBy])
  @@map("tasks")
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ============================================
// FEATURE FLAGS
// ============================================

model FeatureFlag {
  id          String              @id @default(cuid())
  name        String              @unique // CONTRACTS, LICENSES, CMDB, etc.
  displayName String // "Contract Management"
  description String              @db.Text
  category    FeatureFlagCategory
  isEnabled   Boolean             @default(false) // Default: DISABLED (admin must enable)
  isSystem    Boolean             @default(false) // System flags (e.g., MAINTENANCE_MODE)

  // Dependencies (array of feature names)
  dependsOn String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
  @@index([category])
  @@map("feature_flags")
}

// Audit log for feature flag changes
model FeatureFlagAuditLog {
  id          String            @id @default(cuid())
  featureName String
  action      FeatureFlagAction
  userId      String
  userEmail   String
  reason      String?           @db.Text
  createdAt   DateTime          @default(now())

  @@index([featureName])
  @@index([userId])
  @@index([createdAt])
  @@map("feature_flag_audit_logs")
}

// Feature flag category
enum FeatureFlagCategory {
  SYSTEM
  LAYER_1
  LAYER_2
  LAYER_3
}

// Feature flag action
enum FeatureFlagAction {
  ENABLED
  DISABLED
}

// ============================================
// SYSTEM SETTINGS
// ============================================

// Database-backed application settings with env var fallback
model SystemSetting {
  id             String   @id @default(cuid())
  key            String   @unique
  value          String?  @db.Text
  isEncrypted    Boolean  @default(false)
  updatedBy      String?
  updatedByEmail String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@index([key])
  @@map("system_settings")
}
