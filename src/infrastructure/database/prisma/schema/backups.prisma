// ============================================
// DATABASE BACKUPS
// ============================================
//
// Models: DatabaseBackup
// Enums: BackupStatus, BackupStage
// Layer: Infrastructure / System Operations
// ============================================

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED

  @@map("backup_status")
}

enum BackupStage {
  INITIALIZING
  DUMPING
  COMPRESSING
  FINALIZING

  @@map("backup_stage")
}

model DatabaseBackup {
  id          String       @id @default(cuid())
  filename    String       @unique
  filePath    String
  fileSize    BigInt       @default(0)
  status      BackupStatus
  stage       BackupStage?
  percentage  Int          @default(0)
  currentStep String?

  createdById String
  createdBy   User    @relation("BackupCreator", fields: [createdById], references: [id])
  notes       String?

  databaseName    String
  postgresVersion String
  tableCount      Int?
  recordCount     BigInt?

  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationSeconds Int?

  errorMessage       String?
  errorCode          String?
  errorDetails       String?
  checksum           String?
  dbSchemaVersion    String?
  codeSchemaVersion  String?
  schemaDrift        Boolean? @default(false)
  verificationStatus String?
  verificationError  String?

  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("BackupDeletedByUser", fields: [deletedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("database_backups")
}
