// ============================================
// ASSET KITS & BUNDLES
// ============================================
//
// Models: AssetKit, AssetKitItem, AssetKitCheckout, AssetKitCheckoutItem
// Enums: None
// Layer: Layer 3 (Advanced ITAM)
// Related DI Module: asset-kits.module.ts
// ============================================

// AssetKit model
// Reusable kit templates (e.g., "New Hire Kit", "Executive Package")
model AssetKit {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?  @db.Text
  kitType     AssetKitTypeEnum @default(OTHER)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  items     AssetKitItem[]
  checkouts AssetKitCheckout[]
  deletedBy Person?            @relation("AssetKitDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@unique([name])
  @@index([code])
  @@index([kitType])
  @@index([isActive])
  @@index([deletedAt])
  @@map("asset_kits")
}

// AssetKitItem model
// Items included in a kit template (category or specific model)
model AssetKitItem {
  id              String   @id @default(cuid())
  assetKitId      String
  assetCategoryId String?
  assetModelId    String?
  quantity        Int      @default(1)
  isRequired      Boolean  @default(true)
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  assetKit      AssetKit               @relation(fields: [assetKitId], references: [id], onDelete: Cascade)
  assetCategory AssetCategory?         @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)
  assetModel    AssetModel?            @relation(fields: [assetModelId], references: [id], onDelete: SetNull)
  checkoutItems AssetKitCheckoutItem[]

  // Indexes
  @@index([assetKitId])
  @@index([assetCategoryId])
  @@index([assetModelId])
  @@map("asset_kit_items")
}

// AssetKitCheckout model
// Actual kit checkout instance tracking
model AssetKitCheckout {
  id                 String    @id @default(cuid())
  assetKitId         String
  assigneeType       KitAssigneeTypeEnum @default(PERSON)
  assigneeId         String
  checkoutDate       DateTime  @default(now())
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?
  status             KitCheckoutStatusEnum @default(CHECKED_OUT)
  checkedOutById     String
  note               String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  assetKit     AssetKit               @relation(fields: [assetKitId], references: [id], onDelete: Restrict)
  checkedOutBy Person                 @relation("KitCheckoutBy", fields: [checkedOutById], references: [id], onDelete: Restrict)
  items        AssetKitCheckoutItem[]

  // Indexes
  @@index([assetKitId])
  @@index([assigneeType, assigneeId])
  @@index([status])
  @@index([checkedOutById])
  @@index([expectedReturnDate])
  @@index([checkoutDate]) // Medium-priority: Checkout history
  @@index([actualReturnDate]) // Medium-priority: Return tracking
  @@map("asset_kit_checkouts")
}

// AssetKitCheckoutItem model
// Individual assets tracked within a kit checkout
model AssetKitCheckoutItem {
  id                  String    @id @default(cuid())
  kitCheckoutId       String
  assetId             String
  kitItemId           String
  checkoutDate        DateTime  @default(now())
  returnDate          DateTime?
  status              KitCheckoutItemStatusEnum @default(CHECKED_OUT)
  conditionAtCheckout String?   @db.Text
  conditionAtReturn   String?   @db.Text
  note                String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  kitCheckout AssetKitCheckout @relation(fields: [kitCheckoutId], references: [id], onDelete: Cascade)
  asset       Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)
  kitItem     AssetKitItem     @relation(fields: [kitItemId], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([kitCheckoutId, assetId])
  @@index([kitCheckoutId])
  @@index([assetId])
  @@index([kitItemId])
  @@index([status])
  @@map("asset_kit_checkout_items")
}

// ============================================
// ASSET KIT ENUMS
// ============================================

enum AssetKitTypeEnum {
  NEW_HIRE
  CONTRACTOR
  EXECUTIVE
  PROJECT
  TEMPORARY
  OTHER
}

enum KitAssigneeTypeEnum {
  PERSON
  ORG_UNIT
  LOCATION
}

enum KitCheckoutStatusEnum {
  CHECKED_OUT
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum KitCheckoutItemStatusEnum {
  CHECKED_OUT
  RETURNED
  DAMAGED
  LOST
}
