// ============================================
// SHARED ENUMS (Cross-Domain)
// ============================================
//
// Enums: TargetObjectTypeEnum
// Purpose: Enums used across multiple domains for polymorphic relations
// Used by: contracts.prisma, governance.prisma, attachments.prisma
// ============================================

// Polymorphic target object types
// Used for linking objects across different domains (attachments, verifications, audit logs)
enum TargetObjectTypeEnum {
  // Foundation Layer
  ORGANIZATION_UNIT
  PERSON
  LOCATION
  VENDOR
  LIFECYCLE_STATE
  LIFECYCLE_TRANSITION

  // CMDB
  CI
  CI_RELATIONSHIP
  RELATIONSHIP_TYPE

  // Asset Layer
  ASSET
  ASSET_ASSIGNMENT
  WARRANTY
  MAINTENANCE_SCHEDULE
  MAINTENANCE_RECORD
  STOCK_MOVEMENT

  // Asset Disposals
  ASSET_DISPOSAL
  DISPOSAL_APPROVAL
  DISPOSAL_DOCUMENT

  // Asset Kits
  ASSET_KIT
  ASSET_KIT_ITEM
  ASSET_KIT_CHECKOUT
  ASSET_KIT_CHECKOUT_ITEM

  // Asset Reservations
  ASSET_RESERVATION
  ASSET_RESERVATION_CONFLICT

  // Contracts & Licenses
  CONTRACT
  LICENSE_ENTITLEMENT
  LICENSE_ALLOCATION
}

// ============================================
// ASSET CONDITION & DEPRECIATION ENUMS
// ============================================

// Asset physical condition
enum AssetConditionEnum {
  NEW
  GOOD
  FAIR
  POOR

  @@map("asset_condition_enum")
}

// Asset depreciation calculation models
enum DepreciationModelEnum {
  STRAIGHT_LINE
  DECLINING_BALANCE
  UNITS_OF_PRODUCTION
  SUM_OF_YEARS_DIGITS

  @@map("depreciation_model_enum")
}

// ============================================
// DISPOSAL ENUMS
// ============================================

// Asset disposal type
enum DisposalTypeEnum {
  SALE
  DONATION
  RECYCLE
  SCRAP
  TRANSFER
  DESTRUCTION

  @@map("disposal_type_enum")
}

// Asset disposal workflow status
enum DisposalStatusEnum {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("disposal_status_enum")
}

// ============================================
// MAINTENANCE ENUMS
// ============================================

// Maintenance schedule frequency type
enum MaintenanceScheduleTypeEnum {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM

  @@map("maintenance_schedule_type_enum")
}

// Maintenance record status
enum MaintenanceStatusEnum {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE

  @@map("maintenance_status_enum")
}

// ============================================
// PRIORITY ENUM (Shared)
// ============================================

// Priority levels for various entities
enum PriorityEnum {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("priority_enum")
}
