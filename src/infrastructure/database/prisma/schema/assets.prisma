// ============================================
// IT ASSET MANAGEMENT (ITAM) - Assets, Models, Stock, Warranty
// ============================================
//
// Models: AssetCategory, AssetCategoryField, AssetModel, StockLocation, StockMovement, Asset, AssetAssignment, Warranty
// Enums: AssigneeTypeEnum, TargetObjectTypeEnum, StockMovementTypeEnum, FieldDataTypeEnum, WarrantyCoverageType
// Layer: Layer 2 (Asset/Inventory)
// Related DI Module: asset.module.ts
// ============================================

// AssetCategory model
model AssetCategory {
  id               String    @id @default(cuid())
  name             String    @unique
  code             String    @unique
  description      String?   @db.Text
  lifecycleModelId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  lifecycleModel LifecycleModel?      @relation(fields: [lifecycleModelId], references: [id], onDelete: SetNull)
  fields         AssetCategoryField[]
  assetModels    AssetModel[]
  assets         Asset[]
  dataOwnerships DataOwnership[]
  kitItems       AssetKitItem[]
  deletedBy      Person?              @relation("AssetCategoryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([code])
  @@index([lifecycleModelId])
  @@index([deletedAt])
  @@map("asset_categories")
}

// AssetCategoryField model
model AssetCategoryField {
  id                String   @id @default(cuid())
  assetCategoryId   String
  fieldDefinitionId String
  isRequired        Boolean  @default(false)
  isUnique          Boolean  @default(false)
  isVisible         Boolean  @default(true)
  uiOrder           Int      @default(0)
  defaultValue      Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  assetCategory   AssetCategory   @relation(fields: [assetCategoryId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Restrict)

  // Indexes
  @@unique([assetCategoryId, fieldDefinitionId])
  @@index([assetCategoryId])
  @@index([fieldDefinitionId])
  @@map("asset_category_fields")
}

// AssetModel model
model AssetModel {
  id                    String    @id @default(cuid())
  assetCategoryId       String
  vendorId              String
  name                  String
  code                  String    @unique
  description           String?   @db.Text
  defaultWarrantyMonths Int?
  defaultAttributes     Json? // default specs: RAM, CPU, screen size, etc.
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  assetCategory AssetCategory @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  assets        Asset[]
  kitItems      AssetKitItem[]
  deletedBy     Person?       @relation("AssetModelDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([code])
  @@index([assetCategoryId])
  @@index([vendorId])
  @@index([deletedAt])
  @@map("asset_models")
}

// StockLocation model
model StockLocation {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  locationId  String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  location           Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  assets             Asset[]
  stockMovementsFrom StockMovement[] @relation("StockMovementFrom")
  stockMovementsTo   StockMovement[] @relation("StockMovementTo")

  // Indexes
  @@index([code])
  @@index([locationId])
  @@map("stock_locations")
}

// StockMovement model
model StockMovement {
  id                  String                     @id @default(cuid())
  movementType        StockMovementTypeEnum
  stockLocationFromId String?
  stockLocationToId   String?
  assetId             String?
  quantity            Int                        @default(1)
  reason              String?                    @db.Text
  performedById       String
  occurredAt          DateTime                   @default(now())
  createdAt           DateTime                   @default(now())

  // Void/Cancel support (replaces delete)
  status              StockMovementStatusEnum    @default(ACTIVE)
  voidedAt            DateTime?
  voidedById          String?
  voidReason          String?                    @db.Text

  // Source tracking for automatic movements
  source              StockMovementSourceEnum    @default(MANUAL)
  sourceReferenceType String?                    // "AssetAssignment", "AssetDisposal", "ImportBatch"
  sourceReferenceId   String?                    // ID of the triggering entity

  // Relations
  stockLocationFrom StockLocation? @relation("StockMovementFrom", fields: [stockLocationFromId], references: [id], onDelete: SetNull)
  stockLocationTo   StockLocation? @relation("StockMovementTo", fields: [stockLocationToId], references: [id], onDelete: SetNull)
  asset             Asset?         @relation(fields: [assetId], references: [id], onDelete: SetNull)
  performedBy       Person         @relation("StockMovementPerformedBy", fields: [performedById], references: [id], onDelete: Restrict)
  voidedBy          Person?        @relation("StockMovementVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([movementType])
  @@index([stockLocationFromId])
  @@index([stockLocationToId])
  @@index([assetId])
  @@index([performedById])
  @@index([occurredAt])
  @@index([status])
  @@index([source])
  @@index([sourceReferenceType, sourceReferenceId])
  @@index([voidedAt])
  @@index([voidedById])
  @@map("stock_movements")
}

// Asset model
model Asset {
  id                     String                 @id @default(cuid())
  assetTag               String                 @unique
  assetCategoryId        String
  assetModelId           String?
  vendorId               String?
  contractId             String?
  lifecycleStateId       String?
  serialNumber           String?                @unique
  purchaseDate           DateTime?
  purchaseCost           Decimal?               @db.Decimal(12, 2)
  purchaseCostSar        Decimal?               @db.Decimal(12, 2) // Frozen SAR snapshot at create/update
  currency               String?
  depreciationModel      DepreciationModelEnum?
  depreciationStart      DateTime?
  depreciationEnd        DateTime?
  condition              AssetConditionEnum? // Asset condition: NEW, GOOD, FAIR, POOR
  currentStockLocationId String?
  attributes             Json? // dynamic fields per AssetCategoryField
  note                   String?                @db.Text
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Audit trail fields
  createdById String?
  updatedById String?

  // Relations
  assetCategory        AssetCategory         @relation(fields: [assetCategoryId], references: [id], onDelete: Restrict)
  assetModel           AssetModel?           @relation(fields: [assetModelId], references: [id], onDelete: SetNull)
  vendor               Vendor?               @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  contract             Contract?             @relation(fields: [contractId], references: [id], onDelete: SetNull)
  lifecycleState       LifecycleState?       @relation(fields: [lifecycleStateId], references: [id], onDelete: SetNull)
  currentStockLocation StockLocation?        @relation(fields: [currentStockLocationId], references: [id], onDelete: SetNull)
  warranties           Warranty[]
  configurationItems   ConfigurationItem[]
  stockMovements       StockMovement[]
  assetAssignments     AssetAssignment[]
  maintenanceSchedules MaintenanceSchedule[]
  maintenanceRecords   MaintenanceRecord[]
  disposals            AssetDisposal[]        @relation("AssetDisposals")
  reservations         AssetReservation[]
  kitCheckoutItems     AssetKitCheckoutItem[]
  serviceAssets        ServiceAsset[]
  intuneDevice         IntuneDevice?          @relation("IntuneDeviceAsset")
  deletedBy            Person?                @relation("AssetDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdBy            Person?                @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            Person?                @relation("AssetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([assetTag])
  @@index([assetCategoryId])
  @@index([assetModelId])
  @@index([vendorId])
  @@index([contractId])
  @@index([lifecycleStateId])
  @@index([serialNumber])
  @@index([currentStockLocationId])
  @@index([condition]) // High-priority: Filter by condition
  @@index([assetCategoryId, lifecycleStateId]) // High-priority: Dashboard queries
  @@index([condition, lifecycleStateId]) // High-priority: Filter by condition + state
  @@index([purchaseDate]) // Medium-priority: Age-based queries
  @@index([depreciationStart, depreciationEnd]) // Medium-priority: Depreciation queries
  @@index([deletedAt])
  @@map("assets")
}

// AssetAssignment model
model AssetAssignment {
  id                    String                 @id @default(cuid())
  assetId               String
  assigneeType          AssigneeTypeEnum
  assigneeId            String // points to Person/OrgUnit/Location/CI depending on type
  startDate             DateTime               @default(now())
  endDate               DateTime?
  isPrimary             Boolean                @default(false)
  conditionOnAssignment String? // Condition when asset was assigned
  conditionOnReturn     String? // Condition when asset was returned
  note                  String?                @db.Text

  // Source tracking (for Intune integration)
  source                AssignmentSourceEnum   @default(MANUAL)
  sourceReferenceType   String? // e.g., "IntuneDevice"
  sourceReferenceId     String? // e.g., IntuneDevice.id

  // Conflict tracking
  hasConflict           Boolean                @default(false)
  conflictNote          String?                @db.Text

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  // Indexes
  @@index([assetId])
  @@index([assigneeType, assigneeId])
  @@index([startDate, endDate])
  @@index([source])
  @@index([sourceReferenceType, sourceReferenceId])
  @@index([hasConflict])
  @@map("asset_assignments")
}

// Warranty model
// Comprehensive warranty tracking with support for multiple warranties per asset
model Warranty {
  id              String               @id @default(cuid())
  assetId         String
  vendorId        String? // Nullable to support third-party warranty providers
  coverageType    WarrantyCoverageType @default(STANDARD)
  coverageDetails String?              @db.Text
  policyReference String?
  slaDetails      Json? // SLA terms, response times, coverage hours
  startDate       DateTime
  endDate         DateTime
  cost            Decimal?             @db.Decimal(12, 2)
  currency        String?
  note            String?              @db.Text
  metadata        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  // Soft delete fields
  deletedAt   DateTime?
  deletedById String?

  // Relations
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  vendor    Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  deletedBy Person? @relation("WarrantyDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  // Indexes
  @@index([assetId])
  @@index([vendorId])
  @@index([startDate, endDate])
  @@index([endDate]) // For expiration queries
  @@index([coverageType])
  @@index([deletedAt])
  @@map("warranties")
}

// ============================================
// ASSET ENUMS
// ============================================

enum AssigneeTypeEnum {
  PERSON
  ORG_UNIT
  LOCATION
  CI
}

enum AssignmentSourceEnum {
  MANUAL        // Created manually by user in ITAM
  INTUNE_SYNC   // Auto-created during daily Intune sync
  INTUNE_MANUAL // Created via manual Intune device linking
  IMPORT        // Created during data import
  SYSTEM        // System-generated
}

enum StockMovementTypeEnum {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum StockMovementStatusEnum {
  ACTIVE
  VOIDED
}

enum StockMovementSourceEnum {
  MANUAL
  ASSIGNMENT
  RETURN
  DISPOSAL
  IMPORT
  LOCATION_CHANGE
  SYSTEM
}

enum FieldDataTypeEnum {
  STRING
  TEXT
  INTEGER
  DECIMAL
  BOOLEAN
  DATE
  DATETIME
  ENUM
  JSON
  CI_REFERENCE
  PERSON_REFERENCE
  ORG_UNIT_REFERENCE
  LOCATION_REFERENCE
  // New data types (Phase 3)
  URL
  EMAIL
  PHONE
  MULTI_SELECT_ENUM
  CURRENCY
  ATTACHMENT_REFERENCE
}

enum WarrantyCoverageType {
  STANDARD
  EXTENDED
  ENHANCED
  PREMIUM
  BASIC
  THIRD_PARTY
  MANUFACTURER
  DEPOT
  ONSITE
  NEXT_BUSINESS_DAY
}
