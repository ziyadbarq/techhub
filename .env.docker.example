# Docker Compose Environment Variables
# Copy this file to .env.docker for local Docker testing
#
# cp .env.docker.example .env.docker
#
# These variables are used by docker-compose.yml for local testing.
# The docker-compose.yml file provides defaults for most values.

# ====================
# Authentication
# ====================
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# Canonical public URL for local Docker testing.
# BETTER_AUTH_URL and NEXT_PUBLIC_APP_URL should match for single-origin setups.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: only set when accessing local Docker from extra browser origins.
# TRUSTED_ORIGINS=http://localhost:3000,http://YOUR_IP:3000

# ====================
# Build Metadata (set by CI via --build-arg; set here for local Docker testing)
# ====================
APP_VERSION=local
GIT_COMMIT=local
BUILD_DATE=local
IMAGE_TAG=local

# ====================
# Optional: Logging
# ====================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ====================
# Optional: Feature Flags
# ====================
# Override specific feature flags if needed
# By default, all features are enabled in local Docker testing
# Example:
# FEATURE_INTUNE_INTEGRATION=false
# FEATURE_SERVICE_MANAGEMENT=true
