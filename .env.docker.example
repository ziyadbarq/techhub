# Docker Compose Environment Variables
# Copy this file to .env.docker for local Docker testing
#
# cp .env.docker.example .env.docker
#
# These variables are used by docker-compose.yml for local testing.
# The docker-compose.yml file provides defaults for most values.

# ====================
# Authentication
# ====================
# Generate a secure secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# Application URL (for local Docker testing)
BETTER_AUTH_URL=http://localhost:3000

# ====================
# Optional: AI Features
# ====================
# OpenAI API key (optional - only needed for AI-powered features)
OPENAI_API_KEY=

# ====================
# Optional: Logging
# ====================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ====================
# Optional: Feature Flags
# ====================
# Override specific feature flags if needed
# By default, all features are enabled in local Docker testing
# Example:
# FEATURE_INTUNE_INTEGRATION=false
# FEATURE_SERVICE_MANAGEMENT=true
