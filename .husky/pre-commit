echo "🔧 Phase 1: Auto-fixing staged files..."
echo "  → Formatting with Prettier"
echo "  → Fixing lint issues with ESLint"
npx lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Auto-fix failed. Please review the errors above."
  exit 1
fi

echo ""
echo "✅ Auto-fixes completed!"
echo ""

# Phase 2: Run checks that require manual intervention
echo "🔍 Phase 2: Checking for issues that need manual editing..."

# Type checking - only checks staged TypeScript files
echo "  → Running TypeScript type check on staged files..."
npm run type-check:staged

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Type check failed. Please fix the type errors above."
  echo "💡 Tip: Run 'npm run type-check' to see all project errors."
  echo "💡 Tip: Run 'npm run type-check:staged' to check only staged files."
  exit 1
fi

echo ""
echo "✅ Type check passed!"
echo ""

# Phase 3: Route generation drift check
if git diff --cached --name-only | grep -q "src/config/routes-manifest.ts"; then
  echo "🔍 Phase 3: routes-manifest.ts staged — checking generated files..."
  npm run generate:routes --silent 2>/dev/null
  ROUTE_DRIFT=$(git diff --name-only -- src/config/navigation-groups/ src/config/protected-routes.ts)
  if [ -n "$ROUTE_DRIFT" ]; then
    echo "  ⚠️  Generated route files were out of date — auto-staging updates..."
    git add src/config/navigation-groups/ src/config/protected-routes.ts
  else
    echo "  ✅ Generated route files are up to date"
  fi
fi

# Phase 4: Drift detection (warn only, non-blocking)
echo "🔍 Phase 4: Checking for migration drift..."
npm run drift:check-warn

# Drift check uses warn-only mode, so it won't block commits
# Exit code 0 or 2 (warning) are both acceptable
drift_exit=$?
if [ $drift_exit -eq 1 ]; then
  echo ""
  echo "⚠️  Migration drift detected: schema changes missing from database"
  echo "💡 Tip: Run 'npx prisma migrate dev --name describe_changes' to fix"
  echo ""
fi

echo ""
echo "✅ All checks passed! Committing..."
