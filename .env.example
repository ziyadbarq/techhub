# Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# IMPORTANT: Never commit .env.production to version control!

# ====================
# Application
# ====================

# NOTE: Do NOT set NODE_ENV manually!
# Next.js automatically sets it:
# - "development" during `npm run dev`
# - "production" during `npm run build` and `npm start`
# Setting it manually causes conflicts and "non-standard NODE_ENV" warnings.

# Log level for production (options: debug, info, warn, error)
# Recommended: 'info' or 'warn' for production to reduce noise
LOG_LEVEL=info
PRISMA_VERBOSE_LOGS=false      # Set to true only when diagnosing Prisma issues (sanitized output)
AUTH_DEBUG_LOGS=false          # Enable temporarily for verbose Better Auth logging (redacted)

# Public URL of your application (used for generating links in emails, webhooks, etc.)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Feature flags polling interval in milliseconds (default: 30000 = 30 seconds)
# Set to 0 to disable automatic polling for feature flag changes
# Useful for detecting maintenance mode, new features, etc.
# Recommended: 30000-60000 for production, can be disabled if not needed
NEXT_PUBLIC_FEATURE_FLAGS_POLL_INTERVAL=30000

# ====================
# Database
# ====================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Note: Do NOT add ?schema=public (causes issues with Prisma v7 + pg adapter)
# Example with managed services:
# - Railway: postgresql://postgres:password@containers-us-west-123.railway.app:5432/railway
# - Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# - Neon: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/main
# - Vercel Postgres: postgres://user:password@ep-xxxx.us-east-1.postgres.vercel-storage.com:5432/verceldb
DATABASE_URL=postgresql://user:password@host:port/database

# Direct database URL (if using connection pooling with Prisma)
# Leave empty if not using connection pooling
DIRECT_DATABASE_URL=

# ====================
# Redis (Background Jobs)
# ====================

# Redis connection URL for BullMQ job queue
# Format: redis://host:port or redis://user:password@host:port
# Managed services:
# - Upstash Redis: redis://default:password@xxxx.upstash.io:6379
# - Railway: redis://default:password@containers-us-west-123.railway.app:6379
# - Redis Cloud: redis://default:password@redis-12345.c1.us-east-1-1.ec2.cloud.redislabs.com:12345
REDIS_URL=redis://localhost:6379

# Redis TLS (if required by your provider)
# Set to 'true' for Upstash and other managed Redis that require TLS
REDIS_TLS=false

# ====================
# AI Services
# ====================

# OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# Required for AI content generation features
OPENAI_API_KEY=sk-...

# AI Debug Mode
# Set to 'true' to write debug traces to .ai-debug/ directory
# WARNING: This can generate large files! Only enable for troubleshooting.
# Recommended for production: 'false'
AI_DEBUG_MODE=false

# ====================
# Email Service (TODO: Configure when implementing real email)
# ====================

# Currently using MockEmailService which logs emails instead of sending
# When ready for production, configure one of these providers:

# SendGrid
# SENDGRID_API_KEY=SG.xxx...
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# DEFAULT_FROM_NAME=Your App Name

# AWS SES
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# Resend
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# Nodemailer (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ====================
# Authentication (TODO: Configure when adding auth)
# ====================

# NextAuth.js
# NEXTAUTH_URL=https://yourdomain.com
# NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Auth0
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=...
# AUTH0_CLIENT_SECRET=...
# AUTH0_BASE_URL=https://yourdomain.com

# ====================
# Real-time Services
# ====================

# Partykit (WebSocket server)
# Only needed if using Partykit for real-time features
# NEXT_PUBLIC_PARTYKIT_HOST=your-project.partykit.dev

# ====================
# Monitoring & Analytics (TODO: Configure when adding monitoring)
# ====================

# Sentry (Error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# Vercel Analytics
# Automatically enabled on Vercel, no config needed

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog (Product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ====================
# File Storage (TODO: Configure if using file uploads)
# ====================

# AWS S3
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Cloudflare R2
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_ACCESS_KEY_ID=...
# CLOUDFLARE_SECRET_ACCESS_KEY=...
# CLOUDFLARE_BUCKET_NAME=...

# Vercel Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ====================
# Security
# ====================

# Rate limiting (if implementing)
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ====================
# Feature Flags (TODO: Configure if using feature flags)
# ====================

# LaunchDarkly
# LAUNCHDARKLY_SDK_KEY=sdk-...

# Split.io
# SPLIT_IO_API_KEY=...

# Flagsmith
# FLAGSMITH_API_KEY=...

# ====================
# Deployment Platform Specific
# ====================

# Vercel
# Automatically sets: VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA
# No additional config needed for basic setup

# Railway
# Automatically sets: RAILWAY_ENVIRONMENT, RAILWAY_PROJECT_ID
# No additional config needed

# Render
# Automatically sets: RENDER, IS_PULL_REQUEST
# No additional config needed

# AWS Amplify
# AWS_APP_ID=...
# AWS_BRANCH=main

# ====================
# Build Optimization
# ====================

# Skip environment variable validation during build
# Only use this if you're setting env vars after build time
# SKIP_ENV_VALIDATION=false

# Disable telemetry
# NEXT_TELEMETRY_DISABLED=1

# ====================
# Development vs Production Notes
# ====================

# Development (.env.local):
# - Uses local PostgreSQL and Redis
# - Mock email service (logs instead of sending)
# - Debug mode enabled
# - Verbose logging

# Production (.env.production):
# - Managed database (Railway, Supabase, Neon, etc.)
# - Managed Redis (Upstash, Redis Cloud, etc.)
# - Real email service (SendGrid, AWS SES, Resend)
# - Debug mode disabled
# - Production logging (info/warn level)
# - HTTPS required
# - Proper secrets management

# ====================
# Security Best Practices
# ====================

# 1. Never commit .env.production to version control
# 2. Use your deployment platform's environment variable UI
# 3. Rotate secrets regularly
# 4. Use different credentials for each environment
# 5. Enable 2FA on all service accounts
# 6. Use managed secrets (AWS Secrets Manager, Vercel env vars, etc.)
# 7. Monitor for exposed secrets with tools like GitGuardian
# 8. Use the principle of least privilege for API keys
