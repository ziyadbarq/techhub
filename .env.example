# Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# IMPORTANT: Never commit .env.production to version control!

# ====================
# Application
# ====================

# NOTE: Do NOT set NODE_ENV manually!
# Next.js automatically sets it:
# - "development" during `npm run dev`
# - "production" during `npm run build` and `npm start`
# Setting it manually causes conflicts and "non-standard NODE_ENV" warnings.

# Log level for production (options: debug, info, warn, error)
# Recommended: 'info' or 'warn' for production to reduce noise
# Note: All logs automatically include request context (requestId, userId, path, method)
#       via AsyncLocalStorage for production debugging and distributed tracing
LOG_LEVEL=info
PRISMA_VERBOSE_LOGS=false      # Set to true only when diagnosing Prisma issues (sanitized output)
AUTH_DEBUG_LOGS=false          # Enable temporarily for verbose Better Auth logging (redacted)

# Canonical public URL of your application (used for client bundle defaults,
# generated links in emails, webhooks, etc.). Keep this aligned with BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Server port (default: 3000)
# The port on which the application will listen
# Note: Ports below 1024 require root/admin privileges
PORT=3000

# ====================
# Spring Cloud Config Server (Optional)
# ====================

# Spring Cloud Config Server URL (optional)
# If set, configuration will be loaded from the config server at startup
# If not set, only local .env files will be used
# Example: http://config-server.baraq.com:8888
CONFIG_SERVER_URL=

# Spring profile to load from config server (optional)
# Overrides automatic profile detection from NODE_ENV
# Default mapping: production → prod, development/test → dev
# Options: dev, uat, prod
# Leave empty to use automatic profile detection
SPRING_PROFILE=

# ====================
# Security (Token Encryption)
# ====================

# AES-256-GCM encryption key for OAuth tokens (REQUIRED for Microsoft SSO)
# Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
# CRITICAL: Never commit this to version control, rotate regularly
# Example below is for reference only - GENERATE YOUR OWN KEY
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Feature flags polling interval in milliseconds (default: 30000 = 30 seconds)
# Set to 0 to completely disable automatic polling (only fetches when tab becomes visible)
# Useful for detecting maintenance mode, new features, etc.
# Notes:
# - Polling automatically pauses when tab is hidden to save resources
# - When set to 0, features still refresh when user returns to tab
# - Recommended: 30000-60000 for production, 0 if real-time updates not needed
NEXT_PUBLIC_FEATURE_FLAGS_POLL_INTERVAL=30000

# ====================
# Database
# ====================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Note: Do NOT add ?schema=public (causes issues with Prisma v7 + pg adapter)
# Example with managed services:
# - Supabase: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# - Neon: postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/main
# - Vercel Postgres: postgres://user:password@ep-xxxx.us-east-1.postgres.vercel-storage.com:5432/verceldb
DATABASE_URL=postgresql://user:password@host:port/database

# Connection pool tuning (optional; defaults shown)
# DATABASE_POOL_MAX=20
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000

# ====================
# Database Backups (Optional)
# ====================

# Backup storage path (default: local/backups)
# BACKUP_STORAGE_PATH=/path/to/backups

# Override pg_dump/psql binaries or flags for backups and restores
# Useful if you have multiple PostgreSQL versions installed or need custom flags
# PG_DUMP_PATH=/usr/local/bin/pg_dump
# PG_DUMP_FLAGS=--jobs=2 --verbose
# PSQL_PATH=/usr/local/bin/psql
# PSQL_FLAGS=--quiet

# Enable temp-db verification for backups (creates/drops a temp DB to replay the dump)
# Set to 'true' to test backup integrity by restoring to a temporary database
# BACKUP_VERIFY_TEMP_DB=true

# ====================
# Redis (Background Jobs + Caching)
# ====================

# Redis connection URL for BullMQ job queue, permission cache, and feature flag cache
# Format: redis://host:port or redis://user:password@host:port
# Used for:
# - Background job queue (BullMQ)
# - Permission cache (multi-process sync, 5-min TTL)
# - Feature flag cache (bulk fetch optimization, 5-min TTL)
# Managed services:
# - Upstash Redis: redis://default:password@xxxx.upstash.io:6379
# - Redis Cloud: redis://default:password@redis-12345.c1.us-east-1-1.ec2.cloud.redislabs.com:12345
# Note: Application gracefully falls back to in-memory cache if Redis unavailable
REDIS_URL=redis://localhost:6379


# ====================
# Microsoft Graph API (Azure AD) - Intune
# ====================

# Azure AD App Registration credentials for Intune device sync
# Get from: https://portal.azure.com > App registrations > [Intune app]
# Required permission: DeviceManagementManagedDevices.Read.All
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# ====================
# Email Service (Microsoft Graph)
# ====================

# Azure AD App Registration for email sending (separate from Intune app above)
# Get from: https://portal.azure.com > App registrations > [Email app]
# Required permission: Mail.Send (Application permission, admin consent required)
AZURE_EMAIL_TENANT_ID=your-email-tenant-id
AZURE_EMAIL_CLIENT_ID=your-email-client-id
AZURE_EMAIL_CLIENT_SECRET=your-email-client-secret

# Sender mailbox (must be licensed for Exchange Online)
AZURE_EMAIL_FROM=noreply@yourdomain.com

# Alternative providers (not implemented):
# Resend: RESEND_API_KEY, RESEND_FROM_EMAIL
# Nodemailer: SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASSWORD

# ====================
# OCI Inventory Download (n8n Webhook)
# ====================

# OCI Cloud Sync (n8n webhook integration)
# Authentication token for n8n webhook to sync OCI infrastructure data
# Used by: OCI Cloud Sync feature (automated) and scripts/imports/download-oci-data.ts (manual)
# Downloads: Compute instances, Load Balancers, OKE clusters, Object Storage, Databases
OCI_SYNC_SOURCE=webhook
OCI_WEBHOOK_TOKEN=your_n8n_webhook_token_here
# Set to "true" to skip TLS certificate verification (for self-signed certs)
OCI_WEBHOOK_INSECURE=false
# Optional: Local OCI snapshot directory for downloader, comparison, and OCI_SYNC_SOURCE=local
OCI_LOCAL_DATA_DIR=local/oci-data
# Optional: Archive directory used by download-oci-data.ts before overwriting snapshots
OCI_LOCAL_DATA_ARCHIVE_DIR=local/oci-data-archive
# Optional: When using OCI_SYNC_SOURCE=local, keep this false by default so stale snapshots
# do not retire current OCI CIs. Set true only if you want local snapshots to reconcile deletions.
OCI_LOCAL_SOURCE_RETIRE_MISSING=false

# ====================
# Authentication (Better Auth)
# ====================

# Better Auth canonical public URL. This should match NEXT_PUBLIC_APP_URL and
# should not be an internal pod/service URL.
BETTER_AUTH_URL=https://yourdomain.com

# Trusted origins for authentication (comma-separated, optional)
# If not set, falls back to BETTER_AUTH_URL
# Use only for extra exact origins, aliases, or transition periods.
# TRUSTED_ORIGINS=https://yourdomain.com,https://alias.yourdomain.com

# Microsoft OAuth Configuration
# Get credentials from: https://portal.azure.com > App registrations
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common  # Use 'common' for multi-tenant, or your tenant ID for single-tenant

# Authentication Controls
# Control which authentication methods are available to users
NEXT_PUBLIC_ENABLE_EMAIL_REGISTRATION=true   # Enable/disable email/password registration UI (login always enabled) (true/false)
NEXT_PUBLIC_ENABLE_MS_AUTH=true              # Enable/disable Microsoft OAuth (both login and registration) (true/false)

# ====================
# Real-time Services
# ====================

# Partykit (WebSocket server)
# Only needed if using Partykit for real-time features
# NEXT_PUBLIC_PARTYKIT_HOST=your-project.partykit.dev

# ====================
# Monitoring & Analytics (TODO: Configure when adding monitoring)
# ====================

# Sentry (Error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=...
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project

# Vercel Analytics
# Automatically enabled on Vercel, no config needed

# ====================
# File Storage (TODO: Configure if using file uploads)
# ====================

# Google Cloud Storage for attachments (signed delivery notes, etc.)
# Unset → files go to ./public/uploads. Auth is Application Default
# Credentials: Workload Identity on GKE, `gcloud auth application-default login` locally.
# Both are required together; the prefix has no default.
#   dev:  gcp-barq-app-dev-website-private / techhub-it-asset-attachments-dev
#   prod: bucket from Jira BPP-2831        / techhub-it-asset-attachments
# GCS_BUCKET_NAME=gcp-barq-app-dev-website-private
# GCS_ATTACHMENTS_PREFIX=techhub-it-asset-attachments-dev

# Cloudflare R2
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_ACCESS_KEY_ID=...
# CLOUDFLARE_SECRET_ACCESS_KEY=...
# CLOUDFLARE_BUCKET_NAME=...

# Vercel Blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ====================
# Security
# ====================

# Rate limiting (if implementing)
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# CORS allowed origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ====================
# Feature Flags (TODO: Configure if using feature flags)
# ====================

# LaunchDarkly
# LAUNCHDARKLY_SDK_KEY=sdk-...

# Split.io
# SPLIT_IO_API_KEY=...

# Flagsmith
# FLAGSMITH_API_KEY=...

# ====================
# Deployment Platform Specific
# ====================

# Vercel
# Automatically sets: VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_GIT_COMMIT_SHA
# No additional config needed for basic setup

# ====================
# Build Optimization
# ====================

# Skip environment variable validation during build
# Only use this if you're setting env vars after build time
# SKIP_ENV_VALIDATION=false

# Skip TypeScript type checking during build (for faster builds)
# WARNING: Use only in development, not recommended for production
# SKIP_TYPE_CHECK=false

# Enable bundle analysis with @next/bundle-analyzer
# Set to 'true' to generate bundle analysis report after build
# ANALYZE=false

# Disable Next.js telemetry
# NEXT_TELEMETRY_DISABLED=1

# ====================
# Development vs Production Notes
# ====================

# Development (.env.local):
# - Uses local PostgreSQL and Redis
# - Mock email service (logs instead of sending)
# - Debug mode enabled
# - Verbose logging

# Production (.env.production):
# - Managed database (Railway, Supabase, Neon, etc.)
# - Managed Redis (Upstash, Redis Cloud, etc.)
# - Real email service (SendGrid, AWS SES, Resend)
# - Debug mode disabled
# - Production logging (info/warn level)
# - HTTPS required
# - Proper secrets management

# ====================
# Security Best Practices
# ====================

# 1. Never commit .env.production to version control
# 2. Use your deployment platform's environment variable UI
# 3. Rotate secrets regularly (especially ENCRYPTION_KEY, client secrets, API keys)
# 4. Use different credentials for each environment (dev/staging/prod)
# 5. Enable 2FA on all service accounts
# 6. Use managed secrets (AWS Secrets Manager, Vercel env vars, etc.)
# 7. Monitor for exposed secrets with tools like GitGuardian
# 8. Use the principle of least privilege for API keys
# 9. Generate strong ENCRYPTION_KEY (32 bytes/64 hex chars) and never reuse across environments
# 10. Back up encryption keys securely - losing them means losing access to encrypted OAuth tokens
