# Lightweight Dockerfile for Local Docker Testing
# Packages pre-built artifacts from host machine
#
# Workflow:
#   1. Build on host: npm run build:fast
#   2. Package in Docker: docker compose -f docker-compose.local.yml up --build
#   3. Run: Already running from step 2!
#
# This matches GitLab CI approach: build natively, Docker just packages

ARG BASE_REGISTRY=docker.io/library
FROM ${BASE_REGISTRY}/node:22-alpine AS runner

# Install minimal system dependencies and Prisma CLI for migrations
RUN apk add --no-cache libc6-compat && \
    npm install -g prisma@7.3.0 tsx@4.19.2 dotenv@16.4.7

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Set production environment
ENV NODE_ENV=production

# Copy pre-built artifacts from host machine
# These are created by running: npm run build:fast
COPY --chown=nextjs:nodejs ./public ./public
COPY --chown=nextjs:nodejs ./.next/standalone ./
COPY --chown=nextjs:nodejs ./.next/static ./.next/static
COPY --chown=nextjs:nodejs ./src/generated/prisma ./src/generated/prisma

# Copy Prisma configuration and schema for migrations
COPY --chown=nextjs:nodejs ./prisma.config.ts ./prisma.config.ts
COPY --chown=nextjs:nodejs ./src/infrastructure/database/prisma/schema ./src/infrastructure/database/prisma/schema

# Create directories for logs and uploads
RUN mkdir -p local/logs local/uploads && \
    chown -R nextjs:nodejs local

# Switch to non-root user
USER nextjs

# Expose application port
EXPOSE 3000

# Health check using Node.js HTTP module (no curl needed)
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/api/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start application
CMD ["node", "server.js"]
