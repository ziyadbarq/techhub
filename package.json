{
  "name": "barq-assets",
  "version": "1.0.0",
  "description": "Enterprise CMDB and IT Asset Management system with Clean Architecture, DI, RBAC, and comprehensive Foundation layer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:restart": "bash scripts/dev/restart-dev.sh && npm run dev",
    "dev:clean": "npm run cache:clear && bash scripts/dev/restart-dev.sh && npm run dev",
    "validate": "npm run type-check && npm run lint && vitest --run",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "type-check:staged": "bash scripts/dev/type-check-staged.sh",
    "generate:routes": "tsx scripts/build/generate-routes.ts",
    "build": "NODE_OPTIONS=\"--require ./scripts/build/silence-baseline-warning.cjs\" npm run type-check && npm run lint && NODE_OPTIONS=\"--require ./scripts/build/silence-baseline-warning.cjs\" node scripts/build/build.js",
    "build:fast": "NODE_OPTIONS=\"--require ./scripts/build/silence-baseline-warning.cjs\" SKIP_TYPE_CHECK=true BROWSERSLIST_IGNORE_OLD_DATA=true next build",
    "build:analyze": "npm run build:quiet && node scripts/build/analyze-bundle.js",
    "build:quiet": "NODE_OPTIONS=\"--require ./scripts/build/silence-baseline-warning.cjs\" BROWSERSLIST_IGNORE_OLD_DATA=true next build",
    "db:generate": "dotenv -e .env.local -- prisma generate && node scripts/build/recreate-prisma-index.js",
    "db:push": "echo '' && echo '❌ ERROR: db:push is disabled in this project' && echo '' && echo '📚 WHY:' && echo '   db:push applies schema changes without creating migration history.' && echo '   This causes drift and breaks future migrations.' && echo '' && echo '✅ INSTEAD USE:' && echo '   npx prisma migrate dev --name describe_your_changes' && echo '' && echo 'See docs/guides/PRISMA_GUIDE.md for details.' && echo '' && exit 1",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e .env.local -- prisma migrate deploy",
    "db:migrate:status": "dotenv -e .env.local -- prisma migrate status",
    "db:seed": "dotenv -e .env.local -- tsx src/infrastructure/database/prisma/seed.ts production",
    "db:seed:dev": "dotenv -e .env.local -- tsx src/infrastructure/database/prisma/seed.ts dev",
    "db:seed:full": "dotenv -e .env.local -- tsx src/infrastructure/database/prisma/seed.ts full",
    "db:seed:interactive": "dotenv -e .env.local -- tsx src/infrastructure/database/prisma/seed-interactive.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:reset": "dotenv -e .env.local -- prisma migrate reset --force && npm run db:seed:dev",
    "db:backup": "bash scripts/deploy/db-backup.sh backup",
    "db:restore": "bash scripts/deploy/db-backup.sh restore",
    "drift:check": "dotenv -e .env.local -- tsx scripts/db/verify-migration-drift.ts",
    "drift:check-warn": "dotenv -e .env.local -- tsx scripts/db/verify-migration-drift.ts --warn-only",
    "drift:fix": "dotenv -e .env.local -- tsx scripts/db/fix-migration-drift.ts",
    "drift:rollback": "dotenv -e .env.local -- tsx scripts/db/rollback-migration-fix.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:email": "dotenv -e .env.local -- tsx --import ./scripts/build/shim-server-only.js scripts/dev/test-email.ts",
    "test:password": "dotenv -e .env.local -- tsx scripts/dev/test-password-compatibility.ts",
    "debug:intune": "dotenv -e .env.local -- tsx --import ./scripts/build/shim-server-only.js scripts/dev/debug-intune-graph.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,md}\" \"!node_modules/**\" \"!.next/**\" \"!.turbo/**\" \"!dist/**\" \"!out/**\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\" \"!node_modules/**\" \"!.next/**\" \"!.turbo/**\" \"!dist/**\" \"!out/**\"",
    "cache:clear": "tsx scripts/dev/clear-cache.ts",
    "reset": "dotenv -e .env.local -- tsx scripts/dev/reset-dev-environment.ts",
    "reset:dev:full": "tsx scripts/dev/clear-cache.ts && npm run reset",
    "roles:manage": "dotenv -e .env.local -- tsx scripts/users/manage-user-roles.ts",
    "sync:users": "dotenv -e .env.local -- tsx --import ./scripts/build/shim-server-only.js scripts/users/sync-users-from-graph.ts",
    "backfill:azure-ids": "dotenv -e .env.local -- tsx --import ./scripts/build/shim-server-only.js scripts/users/backfill-azure-ad-ids.ts",
    "link:user-to-person": "dotenv -e .env.local -- tsx --import ./scripts/build/shim-server-only.js scripts/users/link-user-to-person.ts",
    "fix:admin-perms": "dotenv -e .env.local -- tsx --import ./scripts/build/shim-server-only.js scripts/users/ensure-system-admin-permissions.ts",
    "worker:dev": "dotenv -e .env.local -- tsx watch --import ./scripts/build/shim-server-only.js src/infrastructure/services/queue/worker.ts",
    "worker:start": "dotenv -e .env.local -- tsx --import ./scripts/build/shim-server-only.js src/infrastructure/services/queue/worker.ts",
    "worker:health": "dotenv -e .env.local -- tsx --import ./scripts/build/shim-server-only.js scripts/monitoring/worker-health.ts",
    "queues:board": "dotenv -e .env.local -- tsx scripts/monitoring/bull-board-server.ts",
    "partykit:dev": "partykit dev",
    "partykit:deploy": "partykit deploy",
    "start": "node scripts/deploy/start-server.js --skip-worker",
    "deploy": "node scripts/build/deploy.js",
    "deploy:full": "node scripts/build/deploy.js --install --force-build",
    "start:deploy": "node scripts/build/deploy.js",
    "stop": "bash scripts/dev/stop-services.sh",
    "stop:force": "bash scripts/dev/stop-services.sh --force",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "setup": "npm install && npm run db:migrate && npm run db:seed",
    "prepare": "husky"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "@bull-board/api": "^6.14.2",
    "@bull-board/express": "^6.14.2",
    "@bull-board/ui": "^6.14.2",
    "@dagrejs/dagre": "^1.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@inquirer/checkbox": "^5.0.1",
    "@inquirer/confirm": "^6.0.1",
    "@inquirer/input": "^5.0.1",
    "@inquirer/prompts": "^8.0.1",
    "@inquirer/select": "^5.0.1",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@next/mdx": "^16.0.3",
    "@paralleldrive/cuid2": "^3.0.4",
    "@prisma/adapter-pg": "7.0.0",
    "@prisma/client": "^7.0.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-table": "^8.21.3",
    "@types/file-saver": "^2.0.7",
    "@types/inquirer": "^9.0.9",
    "@types/mdx": "^2.0.13",
    "@types/xlsx": "^0.0.35",
    "@xyflow/react": "^12.9.3",
    "better-auth": "^1.3.34",
    "bullmq": "^5.63.2",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "inquirer": "^13.0.1",
    "inversify": "^7.10.4",
    "ioredis": "^5.8.2",
    "jspdf": "^3.0.4",
    "lucide-react": "^0.554.0",
    "next": "^16.0.6",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "openai": "^6.9.1",
    "ora": "^9.0.0",
    "papaparse": "^5.5.3",
    "partysocket": "^1.1.6",
    "pg": "8.16.3",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "react": "^19.2.0",
    "react-big-calendar": "^1.19.4",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.66.1",
    "recharts": "^3.4.1",
    "reflect-metadata": "^0.2.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.1",
    "@next/bundle-analyzer": "^16.0.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@testcontainers/postgresql": "^11.8.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.48",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.5.0",
    "@types/pg": "8.15.6",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.0.10",
    "baseline-browser-mapping": "^2.8.32",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "^16.0.3",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^16.2.6",
    "partykit": "^0.0.115",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "prisma": "^7.0.1",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.10"
  },
  "lint-staged": {
    "ignore": [
      "src/generated/prisma/**"
    ],
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "partykit": {
      "esbuild": "^0.25.0"
    }
  }
}
