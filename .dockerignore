# Dockerignore for Local Testing with Pre-Built Artifacts (Dockerfile.local)
# This is used when building with pre-built artifacts from host
# We need to include .next/ but exclude everything else

# ====================
# Dependencies (not needed - standalone includes runtime deps)
# ====================
node_modules/
.npm/
.pnpm-store/

# ====================
# Build Artifacts (KEEP .next for local builds)
# ====================
# .next/  # COMMENTED OUT - we need this!
out/
.turbo/
build/
dist/

# ====================
# Git and Version Control
# ====================
.git/
.gitignore
.gitattributes
.github/
.gitlab/

# ====================
# CI/CD Configuration
# ====================
.gitlab-ci.yml
deployment-configs/
ecosystem.config.cjs

# ====================
# Documentation
# ====================
docs/
roadmap/
*.md
!README.md

# ====================
# Development and Testing
# ====================
coverage/
.vitest/
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
vitest.config.ts
vitest.setup.ts
vitest.component.setup.ts

# ====================
# Logs
# ====================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
local/logs/

# ====================
# IDE and Editor Files
# ====================
.vscode/
.idea/
.vs/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db

# ====================
# Environment Files
# ====================
.env
.env.local
.env.docker
.env.production
.env.development
.env.test
.env*.local

# ====================
# Scripts (keep minimal - KEEP scripts/db for migrations)
# ====================
scripts/dev/
scripts/admin/
scripts/ci/
scripts/deploy/
!scripts/db/

# ====================
# Temporary and Cache Files
# ====================
tmp/
temp/
*.tmp
.cache/
build-*.txt
build_info.env
metrics-*.txt

# ====================
# Husky Git Hooks
# ====================
.husky/

# ====================
# Plan Files
# ====================
.claude/

# ====================
# Docker Files (not needed inside container)
# ====================
Dockerfile
Dockerfile.local
docker-compose.yml
docker-compose.local.yml
.dockerignore
.dockerignore.local
